    skos:scopeNote "série konfliktů mezi římskou republikou a jejími spojenci na jedné a Makedonií na druhé straně."@cs .

<https://teater.aiscr.cz/id/2685> rdf:type skos:Concept ;
    skos:altLabel "2. makedonská válka (200-197 př. Kr.)"@cs ;
    skos:altLabel "Second Macedonian War (200-197 B.C.)"@en ;
    skos:broader <https://teater.aiscr.cz/id/2684> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/2557> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/3091> ;
    skos:inScheme <https://w3id.org/atrium/scheme/teater-harvest> ;
    skos:notation "2685" ;
    skos:prefLabel "Second Macedonian War"@en ;
    skos:prefLabel "Zweite Makedonisch-Römische Krieg (r)"@de ;
    skos:prefLabel "druhá makedonská válka (200-197 př. Kr.)"@cs ;
    skos:scopeNote "válka mezi Makedonií, které vládl král Filip V. Makedonský, a římskou republikou, která byla podporována svými spojenci Pergamem a Rhodem. Po bitvě u Kynoskefal byl Filip V. Makedonský nucen stáhnout se z Řecka, nicméně udržel si vládu nad Makedonií."@cs .

<https://teater.aiscr.cz/id/2686> rdf:type skos:Concept ;
    skos:altLabel "4. makedonská válka (151-148 př. Kr.)"@cs ;
    skos:altLabel "Andriskovo povstání (151-148 př. Kr.)"@cs ;
    skos:altLabel "čtvrtá makedonská válka (151-148 př. Kr.)"@cs ;
    skos:broader <https://teater.aiscr.cz/id/2684> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/2557> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/3091> ;
    skos:inScheme <https://w3id.org/atrium/scheme/teater-harvest> ;
    skos:notation "2686" ;
    skos:prefLabel "povstání Andriska (151-148 př. Kr.)"@cs ;
    skos:prefLabel "revolt of Andriscus (150-148 B.C.)"@en ;
    skos:prefLabel "vierte Makedonisch-Römische Krieg (e)"@de ;
    skos:scopeNote "povstání Andriska, který si dělal nároky na makedonský trůn a prohlásil se za Perseova syna, Římané rychle porazili. Po zdolání posledního vážného odporu v roce 148 př. Kr. byly čtyři loutkové republiky rozpuštěny a Makedonie byla oficiálně přeměněna v římskou provincii Macedonia."@cs .

