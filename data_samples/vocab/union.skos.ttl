<https://teater.aiscr.cz/id/391> rdf:type skos:Concept ;
    skos:altLabel "betrothals"@en ;
    skos:altLabel "slib manželství"@cs ;
    skos:altLabel "zasnoubení"@cs ;
    skos:broader <https://teater.aiscr.cz/id/379> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/288> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/352> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/353> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/360> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/374> ;
    skos:inScheme <https://w3id.org/atrium/scheme/teater-harvest> ;
    skos:notation "391" ;
    skos:prefLabel "Verlöbnis (s)"@de ;
    skos:prefLabel "betrothal"@en ;
    skos:prefLabel "zásnuby"@cs ;
    skos:scopeNote "též zasnoubení, jedná se o pomezní období značného významu. U mnoha národů tvoří zvláštní, nezávislou část svatebních obřadů. Zahrnuje odlučovací a pomezní rituály a končí rituály buď úvodního přijetí do nového prostředí nebo odloučení od pomezí považovaného za nezávislou etapu. (Arnold van Gennep)."@cs .

<https://teater.aiscr.cz/id/3910> rdf:type skos:Concept ;
    skos:altLabel "barbar, Barbaři, Barbarizace, Barbarové, Barbarství"@cs ;
    skos:broader <https://teater.aiscr.cz/id/2560> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/2557> ;
    skos:inScheme <https://w3id.org/atrium/scheme/teater-harvest> ;
    skos:notation "3910" ;
    skos:prefLabel "Barbar (r)"@de ;
    skos:prefLabel "Barbarian"@en ;
    skos:prefLabel "Barbaři"@cs ;
    skos:scopeNote "barbaři, původně u Řeků všichni, kdo mluvili cizí, Řekům nesrozumitelnou řečí. Od řecko-perských válek byl v tomto slově obsažen navíc hanlivý odstín hrubosti, krutosti a nevzdělanosti; ten pak od doby helénist. převládl."@cs .

<https://teater.aiscr.cz/id/3911> rdf:type skos:Concept ;
    skos:broader <https://teater.aiscr.cz/id/2560> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/2557> ;
    skos:inScheme <https://w3id.org/atrium/scheme/teater-harvest> ;
    skos:notation "3911" ;
    skos:prefLabel "Belgae"@en ;
    skos:prefLabel "Belger (e)"@de ;
    skos:prefLabel "Belgové"@cs ;
    skos:scopeNote "Belgové, obyvatelé sev. části  Gallie sídlící mezi Rýnem a Atlantským oceánem (= Britanským mořem). Jejich četné kmeny přemohl  Caesar r. 57 př. n. l. a území se stalo řím. provincií (Belgica). Hlavní město Durocortorum (Reims, Remeš)."@cs .

<https://teater.aiscr.cz/id/3912> rdf:type skos:Concept ;
    skos:broader <https://teater.aiscr.cz/id/2587> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/2557> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/2560> ;
