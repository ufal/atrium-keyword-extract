    skos:broaderTransitive <https://teater.aiscr.cz/id/1101> ;
    skos:inScheme <https://w3id.org/atrium/scheme/teater-harvest> ;
    skos:notation "1110" ;
    skos:prefLabel "Želiezovce-Kulturgruppe (e)"@de ;
    skos:prefLabel "Želizovce group"@en ;
    skos:prefLabel "želiezovský typ"@cs ;
    skos:scopeNote "na jihozápadním Slovensku, na východní Moravě a ve východní části Dolního Rakouska vyspěla místní LnK do želiezovského typu (sbírka v Želiezovcích), známého z řady sídlišť a menších kostrových pohřebišť (Bíňa, Dvory nad Žitavou, Štúrovo)."@cs .

