<https://teater.aiscr.cz/id/1086> rdf:type skos:Concept ;
    skos:altLabel "Aurignacian culture"@en ;
    skos:altLabel "aurignacká kultura"@cs ;
    skos:broader <https://teater.aiscr.cz/id/1085> ;
