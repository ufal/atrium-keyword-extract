<https://teater.aiscr.cz/id/3116> rdf:type skos:Concept ;
    skos:broader <https://teater.aiscr.cz/id/3095> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/3094> ;
    skos:inScheme <https://w3id.org/atrium/scheme/teater-harvest> ;
    skos:notation "3116" ;
    skos:prefLabel "Legat"@en ;
    skos:prefLabel "Legat (r)"@de ;
    skos:prefLabel "legát"@cs ;
    skos:scopeNote "1. v antickém Římě *legatus* (tj. pověřený), tedy senátor se zvláštním posláním, ve vojsku rádce vojevůdce, později vysoký důstojník, za císařství správce provincie; 2. v římskokatolické církvi zplnomocněný papežský vyslanec nebo zplnomocněnec. Rozlišovali se *legati nati*, což byli biskupové pověření trvale zastupováním papeže, a *legati a latere*, tedy pobočníci, kteří byli do jednotlivých zemí posíláni jen za určitými záležitostmi; 3. v právnické terminologii odkaz v závěti."@cs .

