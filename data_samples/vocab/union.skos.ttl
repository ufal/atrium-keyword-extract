    skos:inScheme <https://w3id.org/atrium/scheme/teater-harvest> ;
    skos:notation "1007" ;
    skos:prefLabel "Speläologie (e)"@de ;
    skos:prefLabel "speleologie"@cs ;
    skos:prefLabel "speleology"@en ;
    skos:scopeNote "The exploration and scientific study of caves, both physical and biological, including geologic studies of their genesis, morphology, and mineralogy. The term was first published by Marten in 1896."@en ;
    skos:scopeNote "nauka zaměřená na výzkum jeskyní, především krasových."@cs .

