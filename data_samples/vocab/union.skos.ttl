<https://teater.aiscr.cz/id/925> rdf:type skos:Concept ;
    skos:altLabel "geological disasters"@en ;
    skos:broader <https://teater.aiscr.cz/id/922> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/288> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/352> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/850> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/913> ;
    skos:inScheme <https://w3id.org/atrium/scheme/teater-harvest> ;
    skos:notation "925" ;
    skos:prefLabel "geological disaster"@en ;
    skos:prefLabel "geologická katastrofa"@cs ;
    skos:prefLabel "geologische Katastrophe (e)"@de ;
    skos:scopeNote "jejich příčinami jsou: zemětřesení - otřesy zemského povrchu nebo jeho zlomové porušení, tsunami, některé sesuvy aj.; záplavy - říční, přílivové aj.; porušení stability zemského povrchu - sesuvy, expanze nebo smrštění půd, poklesy apod.; vulkanismus - exploze, tok lávy, spad pyroklastik žhavých i studených, ničivé bahnotoky z vrcholů ledem krytých sopek aj.; velké impakty."@cs .

