<https://teater.aiscr.cz/id/838> rdf:type skos:Concept ;
    skos:broader <https://teater.aiscr.cz/id/352> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/288> ;
    skos:inScheme <https://w3id.org/atrium/scheme/teater-harvest> ;
    skos:notation "838" ;
    skos:prefLabel "Statistik (e)"@de ;
    skos:prefLabel "statistics"@en ;
    skos:prefLabel "statistika"@cs ;
    skos:scopeNote "obor zabývající se zpracováváním, rozborem a zveřejňováním informací v těsné spojitosti s jejich kvalitativním obsahem. V užším smyslu znamená statistika každý soubor kvantitativních údajů o jakýchkoliv hromadných jevech nebo procesech. V přírodních vědách se statistikou rozumí analýza hromadných jevů, užívající teorii pravděpodobnosti."@cs .

