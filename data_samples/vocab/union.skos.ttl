<https://teater.aiscr.cz/id/2004> rdf:type skos:Concept ;
    skos:broader <https://teater.aiscr.cz/id/1985> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/1788> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/1970> ;
    skos:inScheme <https://w3id.org/atrium/scheme/teater-harvest> ;
    skos:notation "2004" ;
    skos:prefLabel "Schleuder (e)"@de ;
    skos:prefLabel "prak"@cs ;
    skos:prefLabel "sling"@en ;
    skos:scopeNote "prak (řec. sfendoné, lat. funda), zbraň na vrhání kamení. Praku se užívalo i ve vojsku. V hellénistické době a v římské armádě byly zavedeny velké strojní praky, ballisty (lat. ballista z řec. balló = vrhám), jimiž byly vrhány velké kameny i hliněné, kamenné nebo kovové koule na vzdálenost až 350 m."@cs .

<https://teater.aiscr.cz/id/2005> rdf:type skos:Concept ;
    skos:broader <https://teater.aiscr.cz/id/1985> ;
