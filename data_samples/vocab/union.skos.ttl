<https://teater.aiscr.cz/id/789> rdf:type skos:Concept ;
    skos:altLabel "děkanát (církevní správní jednotka)"@cs ;
    skos:altLabel "vicariates"@en ;
    skos:broader <https://teater.aiscr.cz/id/775> ;
