    skos:prefLabel "projectile"@en ;
    skos:prefLabel "projektil"@cs .

<https://teater.aiscr.cz/id/2006> rdf:type skos:Concept ;
    skos:altLabel "battleaxe"@en ;
    skos:altLabel "hammer-axe, battle-axe"@en ;
    skos:altLabel "čakan"@cs ;
    skos:broader <https://teater.aiscr.cz/id/1985> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/1788> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/1970> ;
