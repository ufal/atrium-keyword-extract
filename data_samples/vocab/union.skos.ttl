    skos:prefLabel "Keule (e)"@de ;
    skos:prefLabel "club"@en ;
    skos:prefLabel "palice"@cs ;
    skos:scopeNote "nástroj vyrobený z jednoho kusu, jehož rukojeť přechází do tupého pracovního konce víceméně kyjovitého."@cs .

