    skos:notation "944" ;
    skos:prefLabel "Vulkanologie (e)"@de ;
    skos:prefLabel "volcanology"@en ;
    skos:prefLabel "vulkanologie"@cs ;
    skos:scopeNote "The branch of geology that deals with volcanism, its causes and phenomena."@en ;
    skos:scopeNote "vědní obor studující sopečnou činnost."@cs .

<https://teater.aiscr.cz/id/945> rdf:type skos:Concept ;
    skos:broader <https://teater.aiscr.cz/id/931> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/288> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/352> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/850> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/913> ;
    skos:inScheme <https://w3id.org/atrium/scheme/teater-harvest> ;
    skos:notation "945" ;
    skos:prefLabel "Geochemie (e)"@de ;
    skos:prefLabel "geochemie"@cs ;
    skos:prefLabel "geochemistry"@en ;
    skos:scopeNote "součást geofyziky, studuje chemické složení planety Země a reakce, které probíhají především v zemské kůře. Zkoumá obsah, distribuci a procesy migrace chemických prvků a jejich izotopů ve složkách geologického a životního prostředí na Zemi, látkové a energetické toky, transport chemických komponent v čase a prostoru a jejich interakce s hydrosférou, atmosférou a biosférou. Někdy je vyčleňován obor kosmochemie, který se zaměřuje na stejný předmět zkoumání v rámci vesmíru (geochemie vesmírných těles apod.). Geochemických metod využívá petroarcheologie, geoarcheologie, aj."@cs ;
    skos:scopeNote "the study of the distribution and amounts of the chemical elements in minerals, ores, rocks, soils, water, and the atmosphere, and the study of the circulation of the elements in nature, study of the distribution and abundance of isotopes, including problems of nuclear frequency and stability in the universe. A major concern of geochemistry is the synoptic evaluation of the abundances of the elements in the Earth’s crust and in major classes of rocks and minerals."@en .

<https://teater.aiscr.cz/id/946> rdf:type skos:Concept ;
    skos:broader <https://teater.aiscr.cz/id/945> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/288> ;
