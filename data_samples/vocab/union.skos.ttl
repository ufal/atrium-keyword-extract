<https://teater.aiscr.cz/id/3435> rdf:type skos:Concept ;
    skos:altLabel "portreeves"@en ;
    skos:broader <https://teater.aiscr.cz/id/3430> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/3094> ;
