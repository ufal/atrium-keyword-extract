<https://teater.aiscr.cz/id/1215> rdf:type skos:Concept ;
    skos:altLabel "mladší doba železná"@cs ;
    skos:broader <https://teater.aiscr.cz/id/1071> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/1050> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/1070> ;
    skos:inScheme <https://w3id.org/atrium/scheme/teater-harvest> ;
    skos:notation "1215" ;
    skos:prefLabel "La Tène period"@en ;
    skos:prefLabel "doba laténska"@cs ;
    skos:prefLabel "vorrömische Eisenzeit (e)"@de ;
    skos:scopeNote "archeologické označení pro mladší dobu železnou 450/400 před. n. l.-počátek n. l. (název podle keltského pohřebiště v Ta Tène, Švýcarsko). Období, kdy hlavním činitelem vývoje byli zejména ve střední a západní Evropě Keltové, kteří měli v posledních stoletích před naším letopočtem vysokou hospodářskou a kulturní úroveň."@cs .

