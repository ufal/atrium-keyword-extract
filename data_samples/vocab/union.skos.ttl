    skos:prefLabel "Krönung (e)"@de ;
    skos:prefLabel "coronation"@en ;
    skos:prefLabel "korunovace"@cs ;
    skos:scopeNote "slavnostní ceremoniál nástupu panovníka na trůn; v jeho průběhu dochází k odevzdání výsostných odznaků královské moci – vložení koruny na hlavu, předání žezla a jablka a opásání panovníka mečem. Korunovace bývala zpravidla spojována s prohlášením věrnosti stavů. (František Čapka)."@cs .

<https://teater.aiscr.cz/id/3800> rdf:type skos:Concept ;
