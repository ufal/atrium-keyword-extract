    skos:prefLabel "prvohory"@cs .

<https://teater.aiscr.cz/id/1054> rdf:type skos:Concept ;
    skos:altLabel "mezozoikum"@cs ;
    skos:broader <https://teater.aiscr.cz/id/1051> ;
