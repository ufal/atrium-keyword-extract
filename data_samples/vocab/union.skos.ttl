<https://teater.aiscr.cz/id/1564> rdf:type skos:Concept ;
    skos:broader <https://teater.aiscr.cz/id/1482> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/1481> ;
    skos:inScheme <https://w3id.org/atrium/scheme/teater-harvest> ;
    skos:notation "1564" ;
    skos:prefLabel "Theokoleion"@de ;
    skos:prefLabel "theocoleon"@en ;
    skos:prefLabel "theokoleion"@cs ;
    skos:scopeNote "theokoleion, dům kněží. V Olympii to byla budova čtvercového půdorysu, stála za západní zdí chrámového okrsku (altidy) a skládala se půvcdně z 8, později z 11 čtvercových místností kolem vnitřního dvora. Bylo postaveno asi v polovině 4. stol. př. n. l."@cs .

<https://teater.aiscr.cz/id/1565> rdf:type skos:Concept ;
    skos:altLabel "prison, jail, gaol, correctional facility, correctional institution, penitentiary, prisons, jails, gaols, correctional facilities, correctional institutions, penitentiaries"@en ;
    skos:broader <https://teater.aiscr.cz/id/1482> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/1481> ;
    skos:inScheme <https://w3id.org/atrium/scheme/teater-harvest> ;
    skos:notation "1565" ;
    skos:prefLabel "Gefängnis (s)"@de ;
    skos:prefLabel "prison"@en ;
    skos:prefLabel "věznice"@cs ;
    skos:scopeNote "vězení - ‘carcer’ bylo určeno jen pro těžké provinilce politické a zločince; po uvržení do žaláře následoval hned hrdelní trest. Dlouhodobé věznění z trestu neznalo ani řecké ani římské právo."@cs .

<https://teater.aiscr.cz/id/1566> rdf:type skos:Concept ;
    skos:broader <https://teater.aiscr.cz/id/1482> ;
