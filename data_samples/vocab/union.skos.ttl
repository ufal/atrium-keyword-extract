<https://teater.aiscr.cz/id/1722> rdf:type skos:Concept ;
    skos:altLabel "chrámová předsíň"@cs ;
    skos:altLabel "nartex"@cs ;
    skos:broader <https://teater.aiscr.cz/id/1710> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/1481> ;
