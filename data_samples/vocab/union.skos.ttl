<https://teater.aiscr.cz/id/142> rdf:type skos:Concept ;
    skos:broader <https://teater.aiscr.cz/id/141> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/140> ;
    skos:inScheme <https://w3id.org/atrium/scheme/teater-harvest> ;
    skos:notation "142" ;
    skos:prefLabel "anthracological analysis"@en ;
    skos:prefLabel "anthrakologische Analyse (e)"@de ;
    skos:prefLabel "antrakologická analýza"@cs ;
    skos:scopeNote "určení zuhelnatělých dřev z archeologických nálezů pomocí mikroskopických metod. Antrakotomická analýza je velmi blízká analýze xylotomární."@cs .

<https://teater.aiscr.cz/id/1420> rdf:type skos:Concept ;
    skos:altLabel "viaducts"@en ;
    skos:broader <https://teater.aiscr.cz/id/1413> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/1267> ;
    skos:inScheme <https://w3id.org/atrium/scheme/teater-harvest> ;
    skos:notation "1420" ;
    skos:prefLabel "Viadukt (s)"@de ;
    skos:prefLabel "viaduct"@en ;
    skos:prefLabel "viadukt"@cs ;
    skos:scopeNote "viadukt, (z lat.), mostní stavba pro převedení cesty přes údolí nebo vodní překážku. Dochován je v řec. oblasti nedaleko Knidu z doby kolem r. 300 př. n. l., provedený z kvádrů technikou nepravé klenby. V Alexandrii spojoval *v.*, nesoucí též vodovod, ostrov Faros s pevninou (asi 1 1/2 km). Z řím. *v-ů* je proslulý Pont du Gard (zač. 1. stol. n. l.) u Nimes (Nemausus) v již. Francii, nesoucí vodovod na třípatrové řadě mohutných arkád a v 2. patře (novověkou) silnici."@cs .

