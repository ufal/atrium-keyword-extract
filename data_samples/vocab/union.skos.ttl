    skos:prefLabel "fyzická geografie"@cs ;
    skos:prefLabel "physical geography"@en ;
    skos:prefLabel "physische Geographie (e)"@de ;
    skos:scopeNote "Fyzická geografie je obor geografie, který zkoumá fyzické složky krajinné sféry Země - komplexně i jednotlivě. Zkoumá přírodní složky - litosféru, pedosféru, biorféru, hydrosféru a atmosféru."@cs .

<https://teater.aiscr.cz/id/884> rdf:type skos:Concept ;
