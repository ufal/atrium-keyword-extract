    skos:prefLabel "Kalábrie (Itálie : kraj)"@cs ;
    skos:scopeNote "Calabria (Kalabrie), jv. část Itálie obklopená Adriatickým a Ionským mořem. Význačnější města - přístavy: → Ta- rentum a → Brundisium. Od 8. st. př. n. 1. zakládány řec. kolonie. Římané se stali pány země v letech 272—266 př. n. 1. Zčešť. Kalábrie."@cs .

<https://teater.aiscr.cz/id/4035> rdf:type skos:Concept ;
    skos:altLabel "Campania, Campania (Roman province), Campania, Italy"@en ;
