    skos:broaderTransitive <https://teater.aiscr.cz/id/680> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/681> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/827> ;
    skos:inScheme <https://w3id.org/atrium/scheme/teater-harvest> ;
    skos:notation "3845" ;
    skos:prefLabel "Homeopathic magic"@en ;
    skos:prefLabel "Homöopathische Magie (e)"@de ;
    skos:prefLabel "homeopatická magie"@cs ;
    skos:scopeNote "podle hypotéz evolucionistů vývojově nejstarší fáze lidského myšlení založená na víře, že podobné vytváří podobné. Podle skotského antropologa a religionisty Jamese Georga Frazera jde o snahu a návod aktivně ovládat přírodní zákonitosti prostřednictvím jejich napodobování."@cs .

<https://teater.aiscr.cz/id/3846> rdf:type skos:Concept ;
    skos:broader <https://teater.aiscr.cz/id/3847> ;
