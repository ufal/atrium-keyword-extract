<https://teater.aiscr.cz/id/3313> rdf:type skos:Concept ;
    skos:altLabel "metal chisellery"@en ;
    skos:broader <https://teater.aiscr.cz/id/3238> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/3094> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/3234> ;
    skos:inScheme <https://w3id.org/atrium/scheme/teater-harvest> ;
    skos:notation "3313" ;
    skos:prefLabel "Kupferschmiedekunst (e)"@de ;
    skos:prefLabel "kovotepectví"@cs ;
    skos:prefLabel "metalworking"@en ;
    skos:scopeNote "zpracování zlata, mědi či bronzu vytepáváním do různých tvarů včetně výroby drátu či plechu. Provádělo se kladívky kamennými a později bronzovými, v nálezech někdy provázenými kovadlinkami z týchž surovin (Albrechtice n. Vit.). Uplatnilo se při výrobě ozdob či plechových nádob. (ks)"@cs .

