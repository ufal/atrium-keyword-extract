<https://teater.aiscr.cz/id/3013> rdf:type skos:Concept ;
    skos:altLabel "Kingdom of Northumbria (Anglie)"@cs ;
    skos:altLabel "Kingdom of Northumbria, Norþanhymbra, Northumbria"@en ;
