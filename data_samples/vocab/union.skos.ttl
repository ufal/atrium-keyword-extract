<https://teater.aiscr.cz/id/1529> rdf:type skos:Concept ;
    skos:broader <https://teater.aiscr.cz/id/1482> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/1481> ;
    skos:inScheme <https://w3id.org/atrium/scheme/teater-harvest> ;
    skos:notation "1529" ;
    skos:prefLabel "Lykeion"@de ;
    skos:prefLabel "lyceum"@cs ;
    skos:prefLabel "lyceum"@en ;
    skos:scopeNote "lyceum, lycaeum pochází od řeckého Lykeion, posvátného místa v Athénách zasvěceného bohu Apollónu, zvaném Lykeios, tj. snad ‘Světlodárce’. Bylo to gymnasion, v němž učili sofisté a zejména Aristotelés. Jméno ‘lyceum’ bylo označením státních středních škol ve Francii, Belgii i jinde. U nás tak nazývány vyšší dívčí školy, se zrovnoprávněním žen převáděné na gymnasia."@cs .

<https://teater.aiscr.cz/id/153> rdf:type skos:Concept ;
    skos:broader <https://teater.aiscr.cz/id/141> ;
