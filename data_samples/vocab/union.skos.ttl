    skos:prefLabel "subobor (paleontologie)"@cs .

<https://teater.aiscr.cz/id/3210> rdf:type skos:Concept ;
    skos:altLabel "nomád"@cs ;
    skos:broader <https://teater.aiscr.cz/id/3209> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/3094> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/3196> ;
    skos:inScheme <https://w3id.org/atrium/scheme/teater-harvest> ;
    skos:notation "3210" ;
    skos:prefLabel "Nomade (r)"@de ;
    skos:prefLabel "kočovník"@cs ;
    skos:prefLabel "nomad"@en ;
    skos:scopeNote "lidské skupiny stěhující se za zdroji obživy z místa na místo, bez pevných sídlišť a obydlí a ovšem bez vazby na určitý omezený prostor, jakou vyžaduje rolnictví. Tímto způsobem žily už v paleolitu lovecké tlupy, v mladším pravěku pak silné a bojovné kmeny zabývající se chovem dobytka a především koní, obývající rozsáhlé stepní prostory Eurasie. Našim zeměpisným podmínkám tento způsob obživy nevyhovuje; ostatně v případě eneolitických kultur, kterým byl kvůli chybění sídlišť tento způsob života přičítán (kultura se šňůrovou keramikou, se zvoncovitými poháry) ukazují novější nálezy a poznatky, že rolnictví a vazba na zemědělskou půdu u nich nesporně existovaly. (ms, ks)"@cs .

