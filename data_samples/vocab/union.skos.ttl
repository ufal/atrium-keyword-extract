    skos:notation "2183" ;
    skos:prefLabel "Apokryphen (e)"@de ;
    skos:prefLabel "apocryphus"@en ;
    skos:prefLabel "apokryf"@cs ;
    skos:scopeNote "výraz pro nepravý, podvržený spis či mystifikaci. Jedná se o spis nebo vyobrazení, vydávající se za něco, čím ve skutečnosti není. Patří sem i apokryfy starozákonních a novozákonních knih; výraz pochází z řečtiny."@cs .

