<https://teater.aiscr.cz/id/951> rdf:type skos:Concept ;
    skos:broader <https://teater.aiscr.cz/id/931> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/288> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/352> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/850> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/913> ;
    skos:inScheme <https://w3id.org/atrium/scheme/teater-harvest> ;
    skos:notation "951" ;
    skos:prefLabel "Geomorphologie (e)"@de ;
    skos:prefLabel "geomorfologie"@cs ;
    skos:prefLabel "geomorphology"@en ;
    skos:scopeNote "nauka o tvarech zemského povrchu a jejich vývoji. Je součástí fyzické geografie. Zabývá se vlivem exogenních a endogenních činitelů na vývoj zemského povrchu, například studiem podnebí, řek, ledovců, stojatých vod na pobřeží. Svými výzkumy vývoje krajiny a procesů, které ji vytvářejí, zasahuje geomorfologie do mnoha dalších oborů, například archeologie, geologie, pedologie, biologie."@cs .

<https://teater.aiscr.cz/id/952> rdf:type skos:Concept ;
    skos:broader <https://teater.aiscr.cz/id/951> ;
