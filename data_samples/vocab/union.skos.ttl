<https://teater.aiscr.cz/id/1915> rdf:type skos:Concept ;
    skos:broader <https://teater.aiscr.cz/id/1912> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/1788> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/1895> ;
    skos:inScheme <https://w3id.org/atrium/scheme/teater-harvest> ;
    skos:notation "1915" ;
    skos:prefLabel "Biga (Wagen) (r)"@de ;
    skos:prefLabel "biga"@cs ;
    skos:prefLabel "biga"@en ;
    skos:scopeNote "biga (-gy, lat.), původnější pomnožné bigy, big (lat. bigae z bi-, značí zdvojení, + iugum = jho), spřežení dvou zvířat, dvouspřeží, též dvouspřežní vůz, zvláště v hippických závodech. Podobně trigy trojspřeží a quadrigy čtverospřeží, i k označení vozu taženého troj- či čtyřspřežím."@cs .

<https://teater.aiscr.cz/id/1916> rdf:type skos:Concept ;
