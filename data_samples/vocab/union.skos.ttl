<https://teater.aiscr.cz/id/4153> rdf:type skos:Concept ;
    skos:broader <https://teater.aiscr.cz/id/902> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/288> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/352> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/850> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/851> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/873> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/896> ;
    skos:inScheme <https://w3id.org/atrium/scheme/teater-harvest> ;
    skos:notation "4153" ;
    skos:prefLabel "Urbanistik (e)"@de ;
    skos:prefLabel "urbanism"@en ;
    skos:prefLabel "urbanismus"@cs ;
    skos:scopeNote "Urbanismus je disciplína, která zkoumá a plánuje sídelní útvary, aby byly funkční a udržitelné. Věnuje se nejen sídlům samotným, ale jejich uspořádání, jednotlivým částem, ale i navazující krajině. \n\nUrbanismus je přímo spojen s územním plánováním, které se věnuje plánování vývoje měst, venkova a krajiny. Cílem je optimalizace vývoje, snahou je udržitelný rozvoj území v ohledu na environmentální, sociální a hospodářské charakteristiky."@cs .

