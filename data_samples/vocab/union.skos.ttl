<https://teater.aiscr.cz/id/3077> rdf:type skos:Concept ;
    skos:altLabel "Anjouovci (rod)"@cs ;
    skos:broader <https://teater.aiscr.cz/id/3076> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/2557> ;
    skos:inScheme <https://w3id.org/atrium/scheme/teater-harvest> ;
    skos:notation "3077" ;
    skos:prefLabel "Angevin"@en ;
    skos:prefLabel "Anjouovci"@cs ;
    skos:prefLabel "Haus Anjou (s)"@de ;
    skos:scopeNote "šlechtický rod pocházející ze severozápadní Francie, který načas vládl v řadě evropských zemí - v Uhrách, Polsku, Neapolsku a na Sicílii. Do prostoru střední Evropy vstoupili Anjouovci po vymření rodu Arpádovců po meči (Ondřej III. zemřel 1301) osobou Karla Roberta, jenž si na základě příbuzenských vztahů s Arpádovci nárokoval uherskou korunu a byl vydatně podporován papežem."@cs .

