    skos:broaderTransitive <https://teater.aiscr.cz/id/1975> ;
    skos:inScheme <https://w3id.org/atrium/scheme/teater-harvest> ;
    skos:notation "1979" ;
    skos:prefLabel "Katapult (r)"@de ;
    skos:prefLabel "catapult"@en ;
    skos:prefLabel "katapult (zbraně)"@cs ;
    skos:scopeNote "Catapulta (-ty, z řec. katapeltés) válečný stroj na metání velkých kamenů."@cs .

<https://teater.aiscr.cz/id/198> rdf:type skos:Concept ;
    skos:broader <https://teater.aiscr.cz/id/197> ;
