<https://teater.aiscr.cz/id/1258> rdf:type skos:Concept ;
    skos:altLabel "antiquity"@en ;
    skos:broader <https://teater.aiscr.cz/id/1257> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/1050> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/1070> ;
    skos:inScheme <https://w3id.org/atrium/scheme/teater-harvest> ;
    skos:notation "1258" ;
    skos:prefLabel "Altertum (s)"@de ;
    skos:prefLabel "ancient history"@en ;
    skos:prefLabel "starověk"@cs ;
    skos:scopeNote "období existence vyspělých civilizací a států městského typu na Předním, Středním a Dálném východě a v Egyptě a klasické antické civilizace v Řecku a ve starém Římě a v Novém světě v oblasti Střední a Jižní Ameriky. Začíná zhruba ve 3. tisíciletí před n. l. a končí v 5. století n. l. (476 n. l. - zánik západořímské říše)."@cs .

