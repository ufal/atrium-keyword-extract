    skos:notation "3912" ;
    skos:prefLabel "Carpi"@en ;
    skos:prefLabel "Karpen (e)"@de ;
    skos:prefLabel "Karpové"@cs ;
    skos:scopeNote "Karpové, dácký kmen, jenž sídlil od počátku 3. stol. n. I. na dolním Dunaji, především v údolích Seretu a Prutu. Podílel se na vpádech barbarů do Dákie a Moesie."@cs .

<https://teater.aiscr.cz/id/3913> rdf:type skos:Concept ;
    skos:broader <https://teater.aiscr.cz/id/2560> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/2557> ;
