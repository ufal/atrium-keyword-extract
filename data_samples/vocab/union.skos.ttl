    skos:inScheme <https://w3id.org/atrium/scheme/teater-harvest> ;
    skos:notation "967" ;
    skos:prefLabel "Lagerstättenkunde (e)"@de ;
    skos:prefLabel "economic geology"@en ;
    skos:prefLabel "ložisková geologie"@cs ;
    skos:scopeNote "The study and analysis of geologic bodies and materials that can be utilized profitably by man, including fuels, metals, nonmetallic minerals, and water; the application of geologic knowledge and theory to the search for and the understanding of mineral deposits."@en ;
    skos:scopeNote "nauka o vzniku a výskytu ložisek nerostných surovin; v aplikované formě se zabývá vyhledáváním ložisek."@cs .

<https://teater.aiscr.cz/id/968> rdf:type skos:Concept ;
    skos:broader <https://teater.aiscr.cz/id/931> ;
