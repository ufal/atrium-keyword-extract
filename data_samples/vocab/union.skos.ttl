    skos:prefLabel "Evangelium (s)"@de ;
    skos:prefLabel "evangelium"@cs ;
    skos:prefLabel "gospel"@en ;
    skos:scopeNote "z řeckého *eu*-*angelion* = dobrá zvěst, radostná zpráva. V Novém zákoně písemné záznamy o životě a učení Kristově. Katolická církev uznává čtyři kanonická evangelia - sv. Matouše, sv. Marka, sv. Lukáše a sv. Jana (ostatní jsou považována za apokryfy, tj. podvržené)."@cs .

