<https://teater.aiscr.cz/id/1270> rdf:type skos:Concept ;
    skos:altLabel "aquae"@cs ;
    skos:altLabel "aquae"@en ;
    skos:broader <https://teater.aiscr.cz/id/1269> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/1267> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/1268> ;
    skos:inScheme <https://w3id.org/atrium/scheme/teater-harvest> ;
    skos:notation "1270" ;
    skos:prefLabel "Thermen (e)"@de ;
    skos:prefLabel "thermae"@en ;
    skos:prefLabel "thermy"@cs ;
    skos:scopeNote "Aquae (lat., Lázně), jméno mnoha antických lázeňských míst s léčivými prameny, např. *A. Aureliae* (dn. Baden-Baden v NSR), *A. Calidae* (dn. Vichy), *A. Mattiacae* (dn. Wiesbaden), *A. Granni* (dn. Aachen = Cáchy); ve stv. byly významné zvl. *A. Sextiae* (Lázně Sextiovy, dn. Aix en Provence) v Narbonskě Galii sev. od Massalie, v území ligurského kmene Saluviů, od r. 122 př. n. I. římská pevnost; r. 102 př. n. I. tu C. Marius porazil Teutony."@cs .

