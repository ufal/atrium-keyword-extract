<https://teater.aiscr.cz/id/997> rdf:type skos:Concept ;
    skos:altLabel "litologie"@cs ;
    skos:broader <https://teater.aiscr.cz/id/931> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/288> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/352> ;
