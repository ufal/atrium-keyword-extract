<https://teater.aiscr.cz/id/173> rdf:type skos:Concept ;
    skos:altLabel "x-ray fluorescence spectrometry"@en ;
    skos:broader <https://teater.aiscr.cz/id/141> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/140> ;
    skos:inScheme <https://w3id.org/atrium/scheme/teater-harvest> ;
    skos:notation "173" ;
