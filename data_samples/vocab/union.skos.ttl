    skos:broaderTransitive <https://teater.aiscr.cz/id/913> ;
    skos:inScheme <https://w3id.org/atrium/scheme/teater-harvest> ;
    skos:notation "964" ;
    skos:prefLabel "Historische Geologie (e)"@de ;
    skos:prefLabel "historical geology"@en ;
    skos:prefLabel "historická geologie"@cs ;
    skos:scopeNote "A major branch of geology that is concerned with the evolution of the Earth and its life forms from its origins to the present day. The study of historical geology therefore involves investigations into stratigraphy, paleontology, and geochronology, as well as the consideration of paleoenvironments, glacial periods, and plate-tectonic motions. It is complementary to physical geology."@en ;
    skos:scopeNote "nauka popisující vývoj Země; je blízká stratigrafii."@cs .

