    skos:inScheme <https://w3id.org/atrium/scheme/teater-harvest> ;
    skos:notation "1916" ;
    skos:prefLabel "Triga (r)"@de ;
    skos:prefLabel "triga"@en ;
    skos:prefLabel "trigae"@cs ;
    skos:scopeNote "trigae (lat. z tri-iugae: tri- značí trojnásobek + iugum = jho), trojspřeží, trojspřežní vůz (biga)."@cs .

<https://teater.aiscr.cz/id/1917> rdf:type skos:Concept ;
    skos:broader <https://teater.aiscr.cz/id/1912> ;
