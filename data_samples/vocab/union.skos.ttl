    skos:prefLabel "gaming item"@en ;
    skos:prefLabel "herní předmět"@cs .

<https://teater.aiscr.cz/id/1965> rdf:type skos:Concept ;
    skos:altLabel "žeton"@cs ;
    skos:broader <https://teater.aiscr.cz/id/1964> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/1788> ;
    skos:inScheme <https://w3id.org/atrium/scheme/teater-harvest> ;
    skos:notation "1965" ;
    skos:prefLabel "Spielstein (r)"@de ;
    skos:prefLabel "gaming piece"@en ;
    skos:prefLabel "hrací kamen"@cs ;
    skos:scopeNote "typově vlastně podskupina Kolečka, ale samostatná vzhledem ke specifickému určení a výzdobě. Tvar ploché destičky, někdy s ozdobně profilovanou horní stranou (kubický tvar= Kostka hrací)"@cs .

<https://teater.aiscr.cz/id/1966> rdf:type skos:Concept ;
    skos:altLabel "toy, plaything"@en ;
    skos:broader <https://teater.aiscr.cz/id/1964> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/1788> ;
    skos:inScheme <https://w3id.org/atrium/scheme/teater-harvest> ;
    skos:notation "1966" ;
    skos:prefLabel "Spielzeug (s)"@de ;
    skos:prefLabel "hračka"@cs ;
    skos:prefLabel "toy"@en ;
    skos:scopeNote "hračky se našly už v krétsko-mykénských vykopávkách; také Homér zná dětské hračky. Děti si hrály s loutkami a pohyblivými panenkami, také s nádobíčkem. Na hřišti házely malým míčem vycpaným srstí nebo i velikým nafukovacím. Houpaly se na houpačce, tahaly vozíčky. Hoši honili obruč a káču a pouštěli papírové draky („hady“). Našly se figurky zvířátek, ne však vojáčci ani kuchyňky. Nejmenší děti měly řehtačky. Oblíbená hra byla s kaménky a s oříšky. Ve škole i doma užíváno počítadla jako učebné pomůcky."@cs .

<https://teater.aiscr.cz/id/1967> rdf:type skos:Concept ;
