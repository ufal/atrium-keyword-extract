<https://teater.aiscr.cz/id/1898> rdf:type skos:Concept ;
    skos:broader <https://teater.aiscr.cz/id/1897> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/1788> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/1895> ;
    skos:inScheme <https://w3id.org/atrium/scheme/teater-harvest> ;
    skos:notation "1898" ;
    skos:prefLabel "Einbaum (r)"@de ;
    skos:prefLabel "logboat"@en ;
    skos:prefLabel "monoxyl"@cs ;
    skos:scopeNote "člun zhotovený z jednoho kmene, jehož vnitřní prostor byl vydlabán nebo vypálen. Archeologicky jsou monoxyly doloženy od mezolitu. Známé jsou nálezy velkomoravských člunů z Mikulčic, z doby laténské pochází monoxyl z Mohelnice na Moravě. Monoxyly se obvykle datují pomocí dendrochronologie a datování radiokarbonového."@cs .

