<https://teater.aiscr.cz/id/1802> rdf:type skos:Concept ;
    skos:broader <https://teater.aiscr.cz/id/1789> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/1788> ;
    skos:inScheme <https://w3id.org/atrium/scheme/teater-harvest> ;
    skos:notation "1802" ;
    skos:prefLabel "Metope (e)"@de ;
    skos:prefLabel "metopa"@cs ;
    skos:prefLabel "metope"@en ;
    skos:scopeNote "metopa (řec. *metopé*), součást vlysu na řeckém chrámu dórského slohu (slohy stavitelskě) mezi triglyfy, s nimiž se střídá. Obdélná nebo čtvercová deska, pův. dřevěná nebo terakotová, později zpravidla z kamene, bez výzdoby nebo zdobená malbou, obyč. však reliéfem, s náměty z řec. mýtů. Pozoruhodný je soubor *m-p* z chrámu Héřina u Paesta (Poseidóniá) a v Selínúntu, z Diova chrámu v Olympii, na athénském Parthenónu aj."@cs .

<https://teater.aiscr.cz/id/1803> rdf:type skos:Concept ;
    skos:altLabel "intrados"@en ;
