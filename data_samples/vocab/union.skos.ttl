<https://teater.aiscr.cz/id/279> rdf:type skos:Concept ;
    skos:broader <https://teater.aiscr.cz/id/275> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/140> ;
    skos:inScheme <https://w3id.org/atrium/scheme/teater-harvest> ;
    skos:notation "279" ;
    skos:prefLabel "Faktorenanalyse (e)"@de ;
    skos:prefLabel "factor analysis"@en ;
    skos:prefLabel "faktorová analýza"@cs ;
    skos:scopeNote "matematická (statistická) multivariační metoda, jejímž základním cílem je převedení velkého počtu proměnných na menší počet kategorií nebo faktoru. Hojně se využívá při zpracování naměřených hodnot instrumentálními metodami archeometrii a při práci s velkým počtem dat v archeologii. Do archeologie ji zavedl L. Binford, u nás rozpracoval E. Neustupný, který pro ni razil označení vektorová syntéza."@cs .

