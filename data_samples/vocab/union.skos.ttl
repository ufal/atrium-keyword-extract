<https://teater.aiscr.cz/id/333> rdf:type skos:Concept ;
    skos:altLabel "zoopaleontologie"@cs ;
    skos:broader <https://teater.aiscr.cz/id/326> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/288> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/289> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/318> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/321> ;
    skos:inScheme <https://w3id.org/atrium/scheme/teater-harvest> ;
    skos:notation "333" ;
    skos:prefLabel "Paläozoologie (e)"@de ;
    skos:prefLabel "paleozoologie"@cs ;
    skos:prefLabel "zoopaleontology"@en ;
    skos:scopeNote "část paleontologie, která se zabývá studiem fosilních živočichů a jejich zbytků. Podle velikostí zkoumaných zbytků se dělí na makrozoopaleontologii a mikrozoopaleontologii, ze systematického hlediska na paleoevertebratologii (zkoumá bezobratlé) a paleovertebratologii (zkoumá obratlovce)."@cs .

