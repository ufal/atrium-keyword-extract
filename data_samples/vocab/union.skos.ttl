    skos:prefLabel "Manalis Lapis (r)"@de ;
    skos:prefLabel "lapis manalis"@cs ;
    skos:prefLabel "manalis lapis"@en ;
    skos:scopeNote "lapis manalis, deštný kámen, který pontifikové vlekli v slavnostním průvodě za velkého sucha do města, aby tak přivábili nebeskou rosu."@cs .

<https://teater.aiscr.cz/id/2371> rdf:type skos:Concept ;
    skos:altLabel "státní ceny a vyznamenání"@cs ;
