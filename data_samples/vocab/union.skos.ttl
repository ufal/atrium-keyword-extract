<https://teater.aiscr.cz/id/296> rdf:type skos:Concept ;
    skos:broader <https://teater.aiscr.cz/id/293> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/288> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/289> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/291> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/292> ;
    skos:inScheme <https://w3id.org/atrium/scheme/teater-harvest> ;
    skos:notation "296" ;
    skos:prefLabel "Pollenkunde (e)"@de ;
    skos:prefLabel "palynologie"@cs ;
    skos:prefLabel "palynology"@en ;
    skos:scopeNote "paleobotanická metoda zaměřující se na analýzu pylu recentních i fosilních rostlin, kvantifikaci jednotlivých druhů a následnou rekonstrukci minulé krajiny. Slouží také k určování stáří sedimentů (rašeliny, spraše) z minulých geologických dob. Analyzuje pylová zrnka v různých sedimentech, kam byla zaváta. Podle pylu je rekonstruován převažující porost a klimatické podmínky například v blízkosti současného archeologického naleziště. Pomocí palynologie byly stanoveny hlavně klimatické výkyvy v době poledové. Pyly jsou ze sedimentů izolovány pomocí macerace."@cs .

