    skos:broaderTransitive <https://teater.aiscr.cz/id/1120> ;
    skos:inScheme <https://w3id.org/atrium/scheme/teater-harvest> ;
    skos:notation "1137" ;
    skos:prefLabel "Řivnáč culture"@en ;
    skos:prefLabel "Řivnáč-Kulturgruppe (e)"@de ;
    skos:prefLabel "řivnáčská kultura"@cs ;
    skos:scopeNote "kultura archeologická středních a severozápadních Čech (název podle výšinného sídliště na Řivnáči u Roztok u Prahy) v mladším eneolitu (2600-2300 před n. 1.). Je známo několik desítek výšinných sídlišť."@cs .

