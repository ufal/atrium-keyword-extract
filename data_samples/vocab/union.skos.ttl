    skos:notation "2006" ;
    skos:prefLabel "Hammeraxt (e)"@de ;
    skos:prefLabel "hammer-axe"@en ;
    skos:prefLabel "sekeromlat"@cs ;
    skos:scopeNote "kamenný nebo kovový nástroj s otvorem pro topůrko; na jedné straně se sekerovým břitem, na druhé s úderovou ploškou. Užíván od neolitu. Materiálem pro jeho výrobu je celá řada hornin."@cs .

