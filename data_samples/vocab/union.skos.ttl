<https://teater.aiscr.cz/id/1324> rdf:type skos:Concept ;
    skos:altLabel "calvaries"@en ;
    skos:broader <https://teater.aiscr.cz/id/1322> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/1267> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/1303> ;
    skos:inScheme <https://w3id.org/atrium/scheme/teater-harvest> ;
    skos:notation "1324" ;
    skos:prefLabel "Golgota (e)"@de ;
    skos:prefLabel "calvary"@en ;
    skos:prefLabel "kalvárie"@cs ;
    skos:scopeNote "je počeštěný latinský název Golgoty, kopce, na kterém byl ukřižován Ježíš Kristus. Může označovat:\n\n* Ukřižování Ježíše Krista – výtvarně (zejména sochařsky) zpracovaná scéna ukřižování Ježíše Krista Křížový vrch\n\n* vrch s křížovou cestou, jejíž obrazy scénou na Golgotě obrazně i v terénu vrcholí\n\n* název kopce, který tvarem připomíná lebku (název Calvaria i Golgota je odvozeno od lebky, kterou měla tvarem také připomínat)\n\n* utrpení - přenesený význam"@cs .

