<https://teater.aiscr.cz/id/3972> rdf:type skos:Concept ;
    skos:broader <https://teater.aiscr.cz/id/2560> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/2557> ;
    skos:inScheme <https://w3id.org/atrium/scheme/teater-harvest> ;
    skos:notation "3972" ;
    skos:prefLabel "Taurer (e)"@de ;
    skos:prefLabel "Tauri"@en ;
    skos:prefLabel "Taurové"@cs ;
    skos:scopeNote "Taurové, divoký kmen, jenž náležel pravděpodobně k nejstarším obyvatelům sev. Kavkazu a sev. Krymu (Chersonésos [2] Taurský); v řec. bájích se vyprávělo zvl. o kultu kruté taurské panenské bohyně, jež byla ztotožňována s řec. Artemidou a uctívána lidskými obětmi (sr. Ífigenie)."@cs .

