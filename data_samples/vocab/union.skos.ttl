    skos:prefLabel "mace (palcát)"@en ;
    skos:prefLabel "palcát"@cs ;
    skos:scopeNote "zbraň, víceméně kulovitá forma mlatu s povrchem často členěným žebry nebo trny"@cs .

<https://teater.aiscr.cz/id/2003> rdf:type skos:Concept ;
    skos:altLabel "firearms"@en ;
    skos:broader <https://teater.aiscr.cz/id/1985> ;
