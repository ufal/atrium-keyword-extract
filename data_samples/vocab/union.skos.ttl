<https://teater.aiscr.cz/id/318> rdf:type skos:Concept ;
    skos:broader <https://teater.aiscr.cz/id/289> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/288> ;
    skos:inScheme <https://w3id.org/atrium/scheme/teater-harvest> ;
    skos:notation "318" ;
    skos:prefLabel "Paläontologie (e)"@de ;
    skos:prefLabel "paleontologie"@cs ;
    skos:prefLabel "paleontology"@en ;
    skos:scopeNote "v obecném pojetí vědní obor zkoumající fosilie, vývoj života v minulých geologických dobách, vztahy mezi pozůstatky organismů a horninami, v nichž jsou uloženy. Člení se na paleontologii všeobecnou a systematickou (popisuje objevované druhy, sestavuje přirozený systém druhů, rodů a vyšších přirozených skupin organismů). Obvykle nezahrnuje studium zbytků rostlin (paleobotanika, palynologie) ani lidskou společnost. Paleontologické výzkumy napomáhají vysvětlit vznik některých hornin a určit jejich relativní stáří."@cs .

