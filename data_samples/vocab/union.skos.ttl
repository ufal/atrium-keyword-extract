    skos:scopeNote "talanton (řec. lat. talentum), nejvyšší starořecká váhová jednotka představující i hodnotu peněžní peníze řecké, váhy řecké a římské."@cs .

<https://teater.aiscr.cz/id/2296> rdf:type skos:Concept ;
    skos:altLabel "greek drachma"@en ;
    skos:broader <https://teater.aiscr.cz/id/2276> ;
