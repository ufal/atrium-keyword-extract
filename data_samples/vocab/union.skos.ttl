    skos:notation "2402" ;
    skos:prefLabel "Schläfenring (r)"@de ;
    skos:prefLabel "temple ring"@en ;
    skos:prefLabel "záušnice"@cs ;
    skos:scopeNote "drobný šperk k ozdobě účesu, vyráběný z měděného, bronzového i zlatého, ojediněle stříbrného drátu jednoduchého i zdvojeného, stočeného do kroužku či spirálky. Užíval se v mladším eneolitu a zejména ve starší době bronzové. (ks)"@cs .

