<https://teater.aiscr.cz/id/3067> rdf:type skos:Concept ;
    skos:altLabel "Gross-Polen (Polsko)"@cs ;
    skos:altLabel "Velkopolsko (Polsko)"@cs ;
    skos:altLabel "Wielkopolska (Polsko)"@cs ;
    skos:broader <https://teater.aiscr.cz/id/2900> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/2557> ;
