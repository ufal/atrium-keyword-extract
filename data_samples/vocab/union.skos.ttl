<https://teater.aiscr.cz/id/3425> rdf:type skos:Concept ;
    skos:altLabel "administration and management of the church"@en ;
    skos:altLabel "duchovní správa"@cs ;
    skos:broader <https://teater.aiscr.cz/id/3424> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/3094> ;
    skos:inScheme <https://w3id.org/atrium/scheme/teater-harvest> ;
    skos:notation "3425" ;
    skos:prefLabel "church administration"@en ;
    skos:prefLabel "církevní správa"@cs ;
    skos:prefLabel "geistliche Verwaltung (e)"@de ;
    skos:scopeNote "pro popis starých tisků zahrnuje texty církevně-správního charakteru, jako jsou např. synodní akta, písemnosti týkající se správy farností, rejstříky farníků, zpovědní seznamy a kostelní účty."@cs .

