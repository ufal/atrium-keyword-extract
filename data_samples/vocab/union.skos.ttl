<https://teater.aiscr.cz/id/1104> rdf:type skos:Concept ;
    skos:altLabel "bandkeramik culture"@en ;
    skos:altLabel "kultura lineární keramiky"@cs ;
    skos:altLabel "kultura s volutovou keramikou"@cs ;
    skos:broader <https://teater.aiscr.cz/id/1102> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/1050> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/1070> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/1071> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/1101> ;
    skos:inScheme <https://w3id.org/atrium/scheme/teater-harvest> ;
    skos:notation "1104" ;
    skos:prefLabel "Linienbandkeramikkultur (e)"@de ;
    skos:prefLabel "kultura s lineární keramikou"@cs ;
    skos:prefLabel "linear pottery culture"@en ;
    skos:scopeNote "kultura archeologická nejstarších zemědělských populací ve střední Evropě (5700-4900 před n. l.), zasahující až do Nizozemí a do Moldavska (název odvozen podle ryté lineární výzdoby nádob). Je známa z četných sídlišť: s dlouhými domy (Bylany u Kutné Hory aj.) a z pohřebišť: (Vedrovice). Původ a vznik není plně objasněn; pravděpodobně šlo o další posun prvotních zemědělců z jihovýchodní Evropy."@cs .

<https://teater.aiscr.cz/id/1105> rdf:type skos:Concept ;
    skos:altLabel "kultura vypíchané keramiky"@cs ;
    skos:altLabel "stroked pottery culture"@en ;
    skos:broader <https://teater.aiscr.cz/id/1102> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/1050> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/1070> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/1071> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/1101> ;
    skos:inScheme <https://w3id.org/atrium/scheme/teater-harvest> ;
    skos:notation "1105" ;
    skos:prefLabel "Stichbandkeramische Kultur (e)"@de ;
    skos:prefLabel "kultura s vypíchanou keramikou"@cs ;
    skos:prefLabel "stroke pottery culture"@en ;
    skos:scopeNote "kultura archeologická mladšího neolitu (název podle výzdobné techniky vpichů na povrchu nádob), která vznikla z kultury s lineární keramikou ve střední Evropě (4900-4600 před n. 1.). Hojně se objevují broušené provrtané kamenné nástroje a první žárové hroby."@cs .

