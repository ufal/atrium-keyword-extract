<https://teater.aiscr.cz/id/1868> rdf:type skos:Concept ;
    skos:altLabel "grotesque (painting), grotto-esque"@en ;
    skos:broader <https://teater.aiscr.cz/id/1865> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/1788> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/1814> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/1850> ;
    skos:inScheme <https://w3id.org/atrium/scheme/teater-harvest> ;
    skos:notation "1868" ;
    skos:prefLabel "Groteske (Malerei) (e)"@de ;
    skos:prefLabel "groteska (malba)"@cs ;
    skos:prefLabel "grotesque (painting)"@en ;
    skos:scopeNote "grotesky, italské označení římských dekorativních nástěnných maleb, nalézaných v renesanční době v podzemních ruinách Říma (*grotta* = it. jeskyně), např. v paláci Neronově. Šlo především o dekorativní výplně s ornamentálními, zvl. rostlinnými, řidčeji figurálními motivy. Byly predlohou renes. malířům; podle nich byly vytvořeny např. známé Raffaelovy Grotesky ve Vatikáně."@cs .

