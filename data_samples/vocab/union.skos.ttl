<https://teater.aiscr.cz/id/1133> rdf:type skos:Concept ;
    skos:altLabel "starší název pro Bádenskou kulturu"@cs ;
    skos:broader <https://teater.aiscr.cz/id/1132> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/1050> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/1070> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/1071> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/1120> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/1131> ;
    skos:inScheme <https://w3id.org/atrium/scheme/teater-harvest> ;
    skos:notation "1133" ;
    skos:prefLabel "Kultur mit kannelierter Keramik (e)"@de ;
    skos:prefLabel "cannelated ware culture"@en ;
    skos:prefLabel "kultura s kanelovanou keramikou"@cs ;
    skos:scopeNote "lokální kultura archeologická mladšího eneolitu (3000-2600 před n. 1.), náleží k tzv. bádenskému kulturnímu komplexu. Název kultury byl odvozen podle kanelace (žlábkování) povrchu keramických nádob. Typická jsou pro tuto kulturu menší opevněná výšinná sídliště a měděné sekery."@cs .

