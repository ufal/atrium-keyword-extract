<https://teater.aiscr.cz/id/212> rdf:type skos:Concept ;
    skos:altLabel "konzervace památek"@cs ;
    skos:broader <https://teater.aiscr.cz/id/210> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/140> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/209> ;
    skos:inScheme <https://w3id.org/atrium/scheme/teater-harvest> ;
    skos:notation "212" ;
    skos:prefLabel "Erhaltung von Denkmälern (e)"@de ;
    skos:prefLabel "antiquities conservation"@en ;
    skos:prefLabel "konzervování památek"@cs ;
    skos:scopeNote "Terénní památníky jsou podle rozpracované kategorizace (národní kulturní památka, chráněné krajinné území, území s archeologickými nálezy) konzervovány a ošetřeny přímo v terénu. Ze zákona jsou chráněny proti poškození, zcizení nebo zničení."@cs .

