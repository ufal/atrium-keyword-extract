    skos:notation "963" ;
    skos:prefLabel "Glaziologie (e)"@de ;
    skos:prefLabel "glaciologie"@cs ;
    skos:prefLabel "glaciology"@en ;
    skos:scopeNote "a) The study of all aspects of snow and ice; the science that treats quantitatively the whole range of processes associated with all forms of solid existing water. Syn: cryology. b) The study of existing glaciers and ice sheets, and of their physical properties. This definition is not internationally accepted."@en ;
    skos:scopeNote "nauka o ledu a sněhu, popř. i o současných ledovcích."@cs .

<https://teater.aiscr.cz/id/964> rdf:type skos:Concept ;
    skos:altLabel "paleogeologie"@cs ;
    skos:broader <https://teater.aiscr.cz/id/931> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/288> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/352> ;
