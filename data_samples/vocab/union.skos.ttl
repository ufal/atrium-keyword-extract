<https://teater.aiscr.cz/id/123> rdf:type skos:Concept ;
    skos:altLabel "LIDAR"@cs ;
    skos:altLabel "LLS"@cs ;
    skos:altLabel "Light Detection and Ranging"@en ;
    skos:altLabel "airborne laser scanning"@en ;
    skos:altLabel "airborne laser scanning survey"@en ;
    skos:altLabel "lidar survey"@en ;
    skos:broader <https://teater.aiscr.cz/id/122> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/102> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/103> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/118> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/119> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/121> ;
    skos:inScheme <https://w3id.org/atrium/scheme/teater-harvest> ;
    skos:notation "123" ;
    skos:prefLabel "Lidar"@de ;
    skos:prefLabel "irborne laser scanning survey"@en ;
    skos:prefLabel "letecké laserové skenování"@cs ;
    skos:scopeNote "nová metoda měření povrchu terénu pomocí letadlem neseného laserového skeneru. Měřením odražených paprsků lze velmi přesně mapovat reliéf krajiny a vytvořit digitální výškopisný model - tzv. DEM či DMT. Zařízení dokáže odfiltrovat paprsky odražené povrchovou vegetací, takže dokáže změřit povrch zakrytý lesem a rozeznat na něm reliéfní útvaru typu mohyl, valu, úvozových cest, hranic polí atd."@cs .

<https://teater.aiscr.cz/id/1230> rdf:type skos:Concept ;
    skos:broader <https://teater.aiscr.cz/id/1227> ;
