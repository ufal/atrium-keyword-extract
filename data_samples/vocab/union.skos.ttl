    skos:prefLabel "součást oděvu"@cs .

<https://teater.aiscr.cz/id/2319> rdf:type skos:Concept ;
    skos:altLabel "buttons"@en ;
    skos:broader <https://teater.aiscr.cz/id/2318> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/1788> ;
    skos:inScheme <https://w3id.org/atrium/scheme/teater-harvest> ;
    skos:notation "2319" ;
    skos:prefLabel "Knopf (r)"@de ;
    skos:prefLabel "button"@en ;
    skos:prefLabel "knoflík"@cs ;
    skos:scopeNote "pomůcka k zapínání oděvu, užívaná asi vesměs shodně jako Spínadlo (na opačné části oděvu není dírka, ale našité očko, smyčka), někdy také asi jen jako Korál, Závěsek či jako ozdobná nášivka (tento předmět není uváděn jako samostatný typ, protože není nijak specifický - v této funkci mohl sloužit Knoflík, Korál, Zavěsek aj. včetně předmětů nijak neopracovaných, např. zvířecích zubů)."@cs .

