<https://teater.aiscr.cz/id/1804> rdf:type skos:Concept ;
    skos:broader <https://teater.aiscr.cz/id/1789> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/1788> ;
    skos:inScheme <https://w3id.org/atrium/scheme/teater-harvest> ;
    skos:notation "1804" ;
    skos:prefLabel "Plinthe (e)"@de ;
    skos:prefLabel "plinth"@en ;
    skos:prefLabel "plinthos"@cs ;
    skos:scopeNote "plinthos (2. p. -thu), znamená 1) čtvercovou desku pod basí iónského sloupu; 2) vyčnívající spodní okraj zdi; 3) cihlu; 4) pravoúhlý kámen fasádní zdi. Latinská forma ‘plinthus’ běžně znamená totéž co ‘abacus’ (horní část hlavice sloupu v podobě desky)."@cs .

