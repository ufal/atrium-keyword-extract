    skos:prefLabel "Schlacht von Gaugamela (e)"@de ;
    skos:prefLabel "bitva u Gaugamél (331 př. Kr. : Tel Gomél, Irák)"@cs ;
    skos:scopeNote "jedna z největších a nejvýznamnějších bitev světových dějin, odehrála se 1. října 331 př. Kr. Vojsko Alexandra Velikého v ní dosáhlo fantastického vítězství nad Peršany vedenými králem Dareiem III."@cs .

<https://teater.aiscr.cz/id/2691> rdf:type skos:Concept ;
    skos:altLabel "Gráníkos, bitva, 334 př. Kr."@cs ;
    skos:altLabel "battle of Granicus (334 B.C. : Biga River, Turkey)"@en ;
    skos:altLabel "bitva u řeky Gráníkos (334 př. Kr. Biga Çayı, Turecko : řeka)"@cs ;
    skos:broader <https://teater.aiscr.cz/id/2558> ;
