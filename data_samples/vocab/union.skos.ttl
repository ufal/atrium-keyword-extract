<https://teater.aiscr.cz/id/2180> rdf:type skos:Concept ;
    skos:broader <https://teater.aiscr.cz/id/2167> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/1788> ;
    skos:inScheme <https://w3id.org/atrium/scheme/teater-harvest> ;
    skos:notation "2180" ;
    skos:prefLabel "Sagum (s)"@de ;
    skos:prefLabel "sagum"@cs ;
    skos:prefLabel "sagum"@en ;
    skos:scopeNote "sagum (lat.) - krátký plášť z kusu hrubé vlněné látky, přehozený přes plece a spínaný na pravé pleci; užívali ho za nepohody pastýři a nevolníci. Byl pokládán za oděv keltský nebo germánský. Později patřil k úboru vojenskému a v různých úslovích bvl kladen za symbol války v protikladu tóze, symbolu míru."@cs .

