<https://teater.aiscr.cz/id/2008> rdf:type skos:Concept ;
    skos:altLabel "sabers"@en ;
    skos:broader <https://teater.aiscr.cz/id/1985> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/1788> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/1970> ;
    skos:inScheme <https://w3id.org/atrium/scheme/teater-harvest> ;
    skos:notation "2008" ;
    skos:prefLabel "Säbel (r)"@de ;
    skos:prefLabel "sabre"@en ;
    skos:prefLabel "šavle"@cs ;
    skos:scopeNote "lehká sečná zbraň s čepelí delší než tesák (viz s. 5), ale na rozdíl od meče jednobřitou, štíhlou a alespoň lehce (třeba jen u hrotu) zahnutou; rukojeť v podobě trnovitého až jazykovitého řapu je od čepele oddělena příčkou rovnou či kosočtverečně rozšířenou. Terminologie viz meč."@cs .

<https://teater.aiscr.cz/id/2009> rdf:type skos:Concept ;
