<https://teater.aiscr.cz/id/2609> rdf:type skos:Concept ;
    skos:broader <https://teater.aiscr.cz/id/2596> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/2557> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/2560> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/2595> ;
    skos:inScheme <https://w3id.org/atrium/scheme/teater-harvest> ;
    skos:notation "2609" ;
    skos:prefLabel "Kvádové"@cs ;
    skos:prefLabel "Quaden (e)"@de ;
    skos:prefLabel "Quadi"@en ;
    skos:scopeNote "Kvádové (lat. *Quadi*), germánský kmen, který patřil ke kmenovému svazu Suebů (v ant. pramenech se často pod názvem Suebové rozumějí Kvádové). Za doby římské sídlili hlavně na již. a stř. Moravě a jz. Slovensku. S Římany byli pův. v přátelských stycích, od doby Marka Aurelia převážně v nepřátelských. Byli spojenci sarmatských Jazygú. Z kmene *K-dů* pocházel Vannius (Vanniovo království)."@cs .

<https://teater.aiscr.cz/id/261> rdf:type skos:Concept ;
    skos:altLabel "historické centrum měst"@cs ;
