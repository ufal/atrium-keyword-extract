<https://teater.aiscr.cz/id/1112> rdf:type skos:Concept ;
    skos:broader <https://teater.aiscr.cz/id/1111> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/1050> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/1070> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/1071> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/1101> ;
    skos:inScheme <https://w3id.org/atrium/scheme/teater-harvest> ;
    skos:notation "1112" ;
    skos:prefLabel "Bükk culture"@en ;
    skos:prefLabel "Bükker Kultur (e)"@de ;
    skos:prefLabel "bukovohorská kultura"@cs ;
    skos:scopeNote "(podle Bukových hor - Bükk - v SV Maďarsku) - vznikla v neolitu regionálním vývojem kultur původního zemědělského okruhu lineární keramiky v prostoru JV Slovenska a SV Maďarska, objevuje se však výjimečně i v přilehlých částech Moravy (východní Pomoraví). Typická je pro ni dokonalá tenkostěnná keramika (zejména kulovité hrnce), plošně zdobená hustě rytými (hřebenovými) vzory spirál, meandrů aj. s bílou, žlutou či červenou inkrustací, případně černou a červenou malbou. (ks)"@cs .

