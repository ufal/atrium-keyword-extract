<https://teater.aiscr.cz/id/791> rdf:type skos:Concept ;
    skos:altLabel "concordats"@en ;
    skos:broader <https://teater.aiscr.cz/id/790> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/288> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/352> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/680> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/681> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/683> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/691> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/692> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/693> ;
    skos:inScheme <https://w3id.org/atrium/scheme/teater-harvest> ;
    skos:notation "791" ;
    skos:prefLabel "Konkordat (s)"@de ;
    skos:prefLabel "concordat"@en ;
    skos:prefLabel "konkordát"@cs ;
    skos:scopeNote "1. dohoda mezi státem a církví (zastoupenou papežem jako hlavou římskokatolické církve) o úpravě postavení církve na území státu a vymezující jejich vzájemný poměr. Jde o projev souhlasné vůle (konsensus); 2. kladné usnesení úředního kolegia; 3. povolení vůbec (stavební konsens); 4. v patrimonijních knihách název pro povolovací, propouštěcí list."@cs .

