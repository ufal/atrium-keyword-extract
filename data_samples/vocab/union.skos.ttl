<https://teater.aiscr.cz/id/1427> rdf:type skos:Concept ;
    skos:broader <https://teater.aiscr.cz/id/1426> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/1267> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/1423> ;
    skos:inScheme <https://w3id.org/atrium/scheme/teater-harvest> ;
    skos:notation "1427" ;
    skos:prefLabel "Meierhof"@en ;
    skos:prefLabel "Meierhof (r)"@de ;
    skos:prefLabel "poplužní dvůr"@cs ;
    skos:scopeNote "termín pro panský (vrchnostenský) dvůr s pozemky (*praedium*, *Meierhof*). Obyčejně k němu ještě náležely tzv. kmetcí dvory (selské dvory s rustikálními pozemky)."@cs .

