<https://teater.aiscr.cz/id/180> rdf:type skos:Concept ;
    skos:altLabel "MS"@cs ;
    skos:altLabel "hmotová spektrometrie"@cs ;
    skos:broader <https://teater.aiscr.cz/id/177> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/140> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/141> ;
    skos:inScheme <https://w3id.org/atrium/scheme/teater-harvest> ;
    skos:notation "180" ;
    skos:prefLabel "Massenspektrometrie (e)"@de ;
    skos:prefLabel "hmotnostní spektrometrie"@cs ;
    skos:prefLabel "mass spectrometry"@en ;
    skos:scopeNote "fyzikálně-chemická metoda pro určování hmotnosti atomů, molekulových fragmentů a molekul v ionizovaném stavu, která ke kvalitativnímu a kvantitativnímu stanovení látek využívá rozdílného chování jejich ionizovaných molekul v elektrickém a magnetickém poli. Ionizované molekuly plynů a par jsou vychylovány elektromagnetickým polem ze své dráhy v závislosti na jejich hmotnosti a náboji. Výsledkem je hmotnostní spektrum umožňující stanovit izotopické složení a strukturu látky. Hmotnostní spektrometrie má široké uplatnění při studiu archeologického materiálu. Zejména se využívá ke studiu organických materiálů."@cs .

<https://teater.aiscr.cz/id/1800> rdf:type skos:Concept ;
    skos:broader <https://teater.aiscr.cz/id/1789> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/1788> ;
    skos:inScheme <https://w3id.org/atrium/scheme/teater-harvest> ;
    skos:notation "1800" ;
    skos:prefLabel "Kurvatur (e)"@de ;
    skos:prefLabel "curvature"@en ;
    skos:prefLabel "kurvatura"@cs ;
    skos:scopeNote "kurvatura, v řeckém chrámovém stavitelství zjev, že vodorovné linie a plochy jsou nahrazeny liniemi a plochami lehounce vypuklými. Tak je tomu např. u Parthenónu, jehož podstavná plocha (stylobat) a architráv jsou mírně vypuklé. Účelem kurvatury je vyrovnání optického klamu."@cs .

<https://teater.aiscr.cz/id/1801> rdf:type skos:Concept ;
    skos:altLabel "mascarons"@en ;
    skos:broader <https://teater.aiscr.cz/id/1789> ;
