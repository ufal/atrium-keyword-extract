    skos:prefLabel "bodná zbraň"@cs ;
    skos:prefLabel "stabbing weapon"@en .

<https://teater.aiscr.cz/id/1995> rdf:type skos:Concept ;
    skos:altLabel "cutting arms"@en ;
    skos:broader <https://teater.aiscr.cz/id/1993> ;
