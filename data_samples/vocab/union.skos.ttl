    skos:prefLabel "Lawine (e)"@de ;
    skos:prefLabel "avalanche"@en ;
    skos:prefLabel "lavina"@cs ;
    skos:scopeNote "A large mass of snow, ice, soil, or rock, or mixtures of these materials, falling, sliding, or flowing very rapidly under the force of gravity. Velocities may sometimes exceed 500 km/hr."@en ;
    skos:scopeNote "rychlý sesuv hmot (sněhu, ledu, kamení) po příkrém svahu."@cs .

<https://teater.aiscr.cz/id/959> rdf:type skos:Concept ;
    skos:altLabel "glaciers"@en ;
    skos:broader <https://teater.aiscr.cz/id/954> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/288> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/352> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/850> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/913> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/931> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/951> ;
    skos:inScheme <https://w3id.org/atrium/scheme/teater-harvest> ;
    skos:notation "959" ;
    skos:prefLabel "Gletscher (r)"@de ;
    skos:prefLabel "glacier"@en ;
    skos:prefLabel "ledovec"@cs ;
    skos:scopeNote "masa ledu vznikajícího na souši nad sněžnou čarou, která v chladných obdobích čtvrtohor ležela velmi nízko. Mimořádným případem byl pevninský (kontinentální) ledovec, příkrov souvisle kryjící sever Evropy v síle mnoha set metrů, který se vždy v glaciálních obdobích pleistocénu šířil k jihu a při svém maximu nepatrně překročil i severní hranice českých zemí; tady zanechal své stopy na Frýdlantsku, Opavsku a zejména v Moravské bráně (viz mapku u hesla paleolit). Na jeho přední frontě vznikaly výrazné čelní morény - nakupeniny ledem přemisťovaného (glacigenního) kamenitého materiálu, které ledovec při ústupu zanechal na nejzazší dosažené linii a které se v teplejších mezidobích stávaly zdrojem surovin pro výrobu kamenné štípané industrie (pazourek). Na vrcholcích vyšších hor (u nás Krkonoše, Šumava) vznikaly v glaciálech vysokohorské ledovce.(ks)"@cs .

