    skos:notation "3946" ;
    skos:prefLabel "Latiner (r)"@de ;
    skos:prefLabel "Latinové"@cs ;
    skos:prefLabel "Latins"@en ;
    skos:scopeNote "Latinové (vysl. Latýnové), italický kmen přistěhovalý ze severu Itálie a obývající → Latium s hlavním městem zvaným Alba Longa. R. 496 př. n. l. podlehli Římanům. Od r. 338 př. n. l. stali se římskými spojenci s řím. právem."@cs .

<https://teater.aiscr.cz/id/3947> rdf:type skos:Concept ;
    skos:broader <https://teater.aiscr.cz/id/2560> ;
