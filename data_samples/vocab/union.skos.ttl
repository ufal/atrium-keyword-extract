<https://teater.aiscr.cz/id/990> rdf:type skos:Concept ;
    skos:altLabel "petrografie"@cs ;
    skos:broader <https://teater.aiscr.cz/id/931> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/288> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/352> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/850> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/913> ;
    skos:inScheme <https://w3id.org/atrium/scheme/teater-harvest> ;
    skos:notation "990" ;
    skos:prefLabel "Petrologie (e)"@de ;
    skos:prefLabel "petrography"@en ;
    skos:prefLabel "petrologie"@cs ;
    skos:scopeNote "vědní disciplína geologických věd. Studuje a zkoumá horniny z hlediska genetického, mineralogického složení hornin aj. Člení se na petrologii systematickou (nerostné složení hornin, vlastnosti hornin) a na petrologii všeobecnou (zákonitosti vzniku a přeměn hornin, genetické vztahy minerálů skládajících horniny). Podle druhu hornin se dělí na petrologii hornin vyvřelých, přeměněných a usazených. Popisným odvětvím petrologie je petrografie."@cs .

