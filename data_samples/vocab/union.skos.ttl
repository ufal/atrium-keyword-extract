    skos:notation "4050" ;
    skos:prefLabel "Kythira"@en ;
    skos:prefLabel "Kythira (s)"@de ;
    skos:prefLabel "Kythéra"@cs ;
    skos:scopeNote "Kythéra, hornatý ostrov jižně od Peloponnésu, osídlený v historické době Dóry, kteří se tu zabývali převážně chovem dobytka a rybolovem. Na ostrově kvetl kult bohyně Afrodíty, jež se podle *K-ry* nazývala básnicky ‘Kythéřanka‘.  Z antiky se nezachovaly žádné významně památky"@cs .

<https://teater.aiscr.cz/id/4051> rdf:type skos:Concept ;
