    skos:broaderTransitive <https://teater.aiscr.cz/id/869> ;
    skos:inScheme <https://w3id.org/atrium/scheme/teater-harvest> ;
    skos:notation "872" ;
    skos:prefLabel "městská krajina"@cs ;
    skos:prefLabel "städtische Landschaft (e)"@de ;
    skos:prefLabel "urban landscape"@en ;
    skos:scopeNote "Městská neboli urbánní krajina je typ kulturní krajiny. Jedná se o sídelní krajinu, která je hustě zastavěná, tedy o krajinu města a jeho částí."@cs .

