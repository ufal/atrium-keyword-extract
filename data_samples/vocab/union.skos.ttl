    skos:scopeNote "peribolos, zděná ohrada okolo posvátného chrámového okrsku (např. v Delfách, Olympii aj.)."@cs .

<https://teater.aiscr.cz/id/1316> rdf:type skos:Concept ;
    skos:broader <https://teater.aiscr.cz/id/1304> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/1267> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/1303> ;
