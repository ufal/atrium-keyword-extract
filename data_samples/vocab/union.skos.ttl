    skos:prefLabel "Kabeirion"@de ;
    skos:prefLabel "cabeirion"@en ;
    skos:prefLabel "kabeirion"@cs ;
    skos:scopeNote "Kabeirion, [2. p. -ia], svatyně pro mystérijní kult Kabeirů."@cs .

<https://teater.aiscr.cz/id/1313> rdf:type skos:Concept ;
    skos:broader <https://teater.aiscr.cz/id/1304> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/1267> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/1303> ;
    skos:inScheme <https://w3id.org/atrium/scheme/teater-harvest> ;
    skos:notation "1313" ;
    skos:prefLabel "Metroon"@en ;
    skos:prefLabel "Metroon (s)"@de ;
    skos:prefLabel "Métróon"@cs ;
    skos:scopeNote "Métróon,chrám Matky bohů. V Athénách stálo Métróon na agoře vedle radnice a v jedné z jeho místností byl uložen státní archiv. Métróon v Olympii (ze začátku 4. stol. př. n. l.) sloužilo v římské době císařskému kultu."@cs .

<https://teater.aiscr.cz/id/1314> rdf:type skos:Concept ;
    skos:broader <https://teater.aiscr.cz/id/1304> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/1267> ;
