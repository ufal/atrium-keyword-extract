    skos:notation "3932" ;
    skos:prefLabel "Marser (e)"@de ;
    skos:prefLabel "Marsi"@en ;
    skos:prefLabel "Marsové"@cs ;
    skos:scopeNote "Marsové, italický kmen, jehož sídla byla ve střední Itálii. Římské nadvládě se poddali r. 304 př. n. l. po porážce Samnitů Římany."@cs .

<https://teater.aiscr.cz/id/3933> rdf:type skos:Concept ;
    skos:broader <https://teater.aiscr.cz/id/2560> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/2557> ;
    skos:inScheme <https://w3id.org/atrium/scheme/teater-harvest> ;
    skos:notation "3933" ;
    skos:prefLabel "Cantabri"@en ;
    skos:prefLabel "Kantabrer (e)"@de ;
    skos:prefLabel "Kantabrové"@cs ;
    skos:scopeNote "Kantabrové, kmen v Hispánii, který obýval severní část tzv. Přední Hispánie (*Hispania citerior*). V jeho společenském zřízení se udržely stopy matriarchátu. Římané *K-ry* po jejich vytrvalém odporu podrobili až r. 19 př. n. l."@cs .

<https://teater.aiscr.cz/id/3934> rdf:type skos:Concept ;
