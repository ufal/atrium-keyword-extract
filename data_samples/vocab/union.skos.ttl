    skos:prefLabel "chladná zbraň"@cs ;
    skos:prefLabel "cold weapon"@en .

<https://teater.aiscr.cz/id/1994> rdf:type skos:Concept ;
    skos:altLabel "stabbing weapons"@en ;
    skos:broader <https://teater.aiscr.cz/id/1993> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/1788> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/1970> ;
