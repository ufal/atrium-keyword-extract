    skos:notation "3913" ;
    skos:prefLabel "Dolopes"@en ;
    skos:prefLabel "Dolopes (e)"@de ;
    skos:prefLabel "Dolopové"@cs ;
    skos:scopeNote "Dolopové, kmen tvořící samostatný státeček sev. od  Aitólie. Postupně se dostali pod vládu  Iásona z  Fer a  Makedoňanů."@cs .

<https://teater.aiscr.cz/id/3914> rdf:type skos:Concept ;
    skos:altLabel "Eburoni, ÉΒούρονες"@cs ;
    skos:broader <https://teater.aiscr.cz/id/2560> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/2557> ;
    skos:inScheme <https://w3id.org/atrium/scheme/teater-harvest> ;
    skos:notation "3914" ;
    skos:prefLabel "Eburonen (e)"@de ;
    skos:prefLabel "Eburones"@en ;
    skos:prefLabel "Eburonové"@cs ;
    skos:scopeNote "Eburonové, keltský kmen v okolí dn. Lutychu. R. 54 př. n. I. se vzbouřili proti římské nadvládě. Jejich odvetné vyhubení následujícího roku vyvolalo velkou vzpouru, která zachvátila jiné keltské kmeny. Jim v čelo se postavil král gallských Arvernů.  Vercingetorix."@cs .

<https://teater.aiscr.cz/id/3915> rdf:type skos:Concept ;
    skos:altLabel "Foiníčané"@cs ;
    skos:altLabel "Féničané, Féničan"@cs ;
    skos:altLabel "Phoenicians, Phenicians, Phoenician civilization"@en ;
    skos:altLabel "Phoenicians, Poeni"@en ;
    skos:altLabel "Punové"@cs ;
