    skos:prefLabel "Árpáden"@de ;
    skos:scopeNote "panovnický rod, vedlejší větev rodu Kapetovců, vládnoucí v Provensálsku, Anjou, Neapolsku a na Sicílii, v Uhersku a v Polsku."@cs .

<https://teater.aiscr.cz/id/3079> rdf:type skos:Concept ;
    skos:altLabel "Habsburg-Lorraine"@en ;
    skos:altLabel "Habsburkové (rod)"@cs ;
    skos:broader <https://teater.aiscr.cz/id/3076> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/2557> ;
