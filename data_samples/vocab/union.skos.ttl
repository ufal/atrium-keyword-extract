<https://teater.aiscr.cz/id/1351> rdf:type skos:Concept ;
    skos:altLabel "synagogue, Jewish temple, temple"@en ;
    skos:altLabel "synagogues"@en ;
    skos:broader <https://teater.aiscr.cz/id/1350> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/1267> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/1303> ;
    skos:inScheme <https://w3id.org/atrium/scheme/teater-harvest> ;
    skos:notation "1351" ;
    skos:prefLabel "Synagoge (e)"@de ;
    skos:prefLabel "synagoga"@cs ;
    skos:prefLabel "synagogue"@en ;
    skos:scopeNote "synagóga (řec. *synagógé*, shromáždění), židovská modlitebna. Bohoslužba byla v *s-gách* omezena na modlitby a čtení hebrejské bible s výkladem. *S-gy* v Egyptě jsou doloženy od 3. stol. př. n. I. Z 3.-6. stol. n. I. jsou zachovány zbytky četných *s-g* v Palestině, zvl. v Galileji; vyskytují se v nich helénist. stavební a dekorativní prvky i symboly (např. zvěrokruh s Héliem.)"@cs .

