    skos:prefLabel "rod"@en ;
    skos:prefLabel "tyčinka"@cs ;
    skos:scopeNote "polotvar silnější než drát, spíše neohebný"@cs .

<https://teater.aiscr.cz/id/1964> rdf:type skos:Concept ;
    skos:broader <https://teater.aiscr.cz/id/1788> ;
