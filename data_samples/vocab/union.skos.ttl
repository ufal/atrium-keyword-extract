    skos:scopeNote "Kárové, indoevropský kmen obývající Kárii. V antice byli považováni za konzervativce (stará zvyková práva)."@cs .

<https://teater.aiscr.cz/id/3935> rdf:type skos:Concept ;
    skos:broader <https://teater.aiscr.cz/id/2676> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/2557> ;
