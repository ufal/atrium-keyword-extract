<https://teater.aiscr.cz/id/735> rdf:type skos:Concept ;
    skos:altLabel "Anabaptists"@en ;
    skos:altLabel "habáni"@cs ;
    skos:altLabel "novokřtěnci"@cs ;
    skos:altLabel "toufaři"@cs ;
    skos:broader <https://teater.aiscr.cz/id/734> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/288> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/352> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/680> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/681> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/683> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/691> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/692> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/693> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/694> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/733> ;
    skos:inScheme <https://w3id.org/atrium/scheme/teater-harvest> ;
    skos:notation "735" ;
    skos:prefLabel "Anabaptism"@en ;
    skos:prefLabel "Täufer (e)"@de ;
    skos:prefLabel "anabaptisté"@cs ;
    skos:scopeNote "náboženská sekta žijící v komunitách na jižní Moravě. Hnutí novokřtěnců vzniklo v roce 1525 ve Švýcarsku. Útočištěm novokřtěnců se načas (do pobělohorské rekatolizace) stala mimo jiné jižní Morava. Charakteristické pro moravské novokřtěnce bylo společné vlastnictví. Žili v komunitách ve společných domech, tzv. Haushaben. Moravská nekatolická šlechta je přijímala na svých panstvích, demonstrovala tím jednak suverenitu v otázkách náboženství a zároveň jí novokřtěnci přinášeli svou pracovitostí nemalé hospodářské zisky: vynikali hlavně v hrnčířství (výroba fajánse) aj. řemeslech."@cs .

