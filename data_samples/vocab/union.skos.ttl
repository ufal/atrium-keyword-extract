<https://teater.aiscr.cz/id/58> rdf:type skos:Concept ;
    skos:altLabel "artefacts (archaeology)"@en ;
    skos:altLabel "artifacts"@en ;
    skos:broader <https://teater.aiscr.cz/id/57> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/1> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/2> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/51> ;
    skos:inScheme <https://w3id.org/atrium/scheme/teater-harvest> ;
    skos:notation "58" ;
    skos:prefLabel "Artefakt (s)"@de ;
    skos:prefLabel "artefact"@en ;
    skos:prefLabel "artefakt"@cs ;
    skos:scopeNote "1.) obvykle movitý předmět, ale i nemovitý objekt, který vznikl (na rozdíl od ekofaktu) lidskou činností, a to v souladu s normami kultury. Artefakt není výhradně archeologicky pojem, je vhodný pro jakékoli zkoumání hmotné kultury (historické vědy), je však používán převážně archeology. Artefakty patří k základním archeologickým pramenům; 2) uměle vzniklé struktury na řezech provedených tomografií počítačovou nebo rentgenem. Většinou tyto artefakty vyvolávají kovové materiály."@cs .

