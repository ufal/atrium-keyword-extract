    skos:prefLabel "Jordansmühler-Kulturgruppe (e)"@de ;
    skos:prefLabel "Jordanów culture"@en ;
    skos:prefLabel "jordanovská kultura"@cs ;
    skos:scopeNote "archeologická kultura staršího eneolitu (kolem 4000 až 3500 před n. 1.); rozšířená ve Slezsku, na Moravě a v Čechách. Charakteristická je keramika navazující na tradice kultury s moravskou malovanou keramikou a ozdoby z mědi."@cs .

