<https://teater.aiscr.cz/id/111> rdf:type skos:Concept ;
    skos:broader <https://teater.aiscr.cz/id/103> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/102> ;
    skos:inScheme <https://w3id.org/atrium/scheme/teater-harvest> ;
    skos:notation "111" ;
    skos:prefLabel "Weniger Destruktive Forschungsmethode (e)"@de ;
    skos:prefLabel "less destructive method"@en ;
    skos:prefLabel "málo destruktivní metoda"@cs ;
    skos:scopeNote "výzkumy málo destruktivní. Málo destruktivním výzkumem je například povrchový sběr, který jen zdánlivě lokalitu nenarušuje; ve skutečnosti ji lze vysbírat a tím de facto většinu zbývajících informací zničit."@cs .

<https://teater.aiscr.cz/id/1110> rdf:type skos:Concept ;
    skos:broader <https://teater.aiscr.cz/id/1102> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/1050> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/1070> ;
