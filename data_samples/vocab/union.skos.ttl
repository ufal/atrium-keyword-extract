<https://teater.aiscr.cz/id/1587> rdf:type skos:Concept ;
    skos:broader <https://teater.aiscr.cz/id/1579> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/1481> ;
    skos:inScheme <https://w3id.org/atrium/scheme/teater-harvest> ;
    skos:notation "1587" ;
    skos:prefLabel "Kryptoportikus (r)"@de ;
    skos:prefLabel "cryptoporticus"@en ;
    skos:prefLabel "kryptoportikus"@cs ;
    skos:scopeNote "kryptoportikus (lat. cryptoporticus), u Římanů dlouhá klenutá chodba, vestavěná částečně do země a opatřená postranními okny v klenbě. Skýtal ochranu před slunečním žárem a studeným větrem. Vyskytoval se často v přepychových venkovských sídlech římských boháčů, kde spojoval izolované skupiny místností nebo budov"@cs .

