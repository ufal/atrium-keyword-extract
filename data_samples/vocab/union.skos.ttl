<https://teater.aiscr.cz/id/1948> rdf:type skos:Concept ;
    skos:broader <https://teater.aiscr.cz/id/1918> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/1788> ;
    skos:inScheme <https://w3id.org/atrium/scheme/teater-harvest> ;
    skos:notation "1948" ;
    skos:prefLabel "Schlacke (e)"@de ;
    skos:prefLabel "slag"@en ;
    skos:prefLabel "struska"@cs ;
    skos:scopeNote "odpadní materiál vznikající při pyrotechnologických postupech (pyrotechnologie). V archeologii se nejčastěji setkáváme s kovářskými struskami, struskami po tavení měděné či železné rudy, struskami ze sklářské výroby apod. Výskyt strusek na lokalitě naznačuje pravděpodobnost metalurgické činnosti, i když chybí nálezy technologických zařízení. Chemickými rozbory strusek pak lze upřesnit technologické pochody, z nichž odpadový materiál pochází."@cs .

