<https://teater.aiscr.cz/id/2156> rdf:type skos:Concept ;
    skos:altLabel "scythes"@en ;
    skos:broader <https://teater.aiscr.cz/id/2155> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/1788> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/2085> ;
    skos:inScheme <https://w3id.org/atrium/scheme/teater-harvest> ;
    skos:notation "2156" ;
    skos:prefLabel "Sense (e)"@de ;
    skos:prefLabel "kosa"@cs ;
    skos:prefLabel "scythe"@en ;
    skos:scopeNote "nástroj ke sklízení trávy, později i obilí. Skládá se z čepele (č; synonymní termín list) a řapu (ř), který svírá s ostřím čepele zpravidla tupý úhel; na čepeli je hrot (h), hřbet (hř), břit (b) resp. ostří (o). Řap byl připevněn k dřevěnému ratišti kroužkem, někdy třmenovitým. Ve sledovaném období je zastoupena pouze kosa 1/ krátká (synonymní termín polokosa) - s čepelí rovnou nebo zakřivenou."@cs .

<https://teater.aiscr.cz/id/2157> rdf:type skos:Concept ;
    skos:broader <https://teater.aiscr.cz/id/2155> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/1788> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/2085> ;
    skos:inScheme <https://w3id.org/atrium/scheme/teater-harvest> ;
    skos:notation "2157" ;
    skos:prefLabel "Hacke (e)"@de ;
    skos:prefLabel "hoe"@en ;
    skos:prefLabel "motyka"@cs ;
    skos:scopeNote "tradiční, ale nesprávný název jednoho z neolitických typů kamenné broušené industrie: jde o teslici s vrtaným otvorem pro topůrko, probíhajícím kolmo na směr ostří - tedy o nástroj k opracování dřeva. (ks)"@cs .

<https://teater.aiscr.cz/id/2158> rdf:type skos:Concept ;
    skos:altLabel "plough, plow (US)"@en ;
    skos:altLabel "ploughs"@en ;
    skos:altLabel "plows"@en ;
