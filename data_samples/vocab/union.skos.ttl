<https://teater.aiscr.cz/id/906> rdf:type skos:Concept ;
    skos:altLabel "sociogeografie"@cs ;
    skos:broader <https://teater.aiscr.cz/id/896> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/288> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/352> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/850> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/851> ;
    skos:broaderTransitive <https://teater.aiscr.cz/id/873> ;
    skos:inScheme <https://w3id.org/atrium/scheme/teater-harvest> ;
    skos:notation "906" ;
    skos:prefLabel "Socialgeographie (e)"@de ;
    skos:prefLabel "human geography"@en ;
    skos:prefLabel "sociální geografie"@cs ;
    skos:scopeNote "Sociální geografie se zabývá sociálními jevy v čase a prostoru - tedy jejich vztahy, prostorovým rozmístěním, zákonitostmi. Od začátku 20. století pracuje se vzájenmným oboustranným vztahem člověk - prostředí.\n\nPojem sociální geografie se prolíná s dalšími disciplínami - antropogeografií, humánní geografií, ekonomickou geografií, regionální geografií. Zároveň má mnoho subdisciplín -  např. geografie sídel, geografie zemědělství, geografie dopravy, geografie kapitálu nebo geografie sociálních problémů."@cs .

