{
  "openapi": "3.1.0",
  "info": {
    "title": "ATRIUM keyword-extract API",
    "description": "The record after nlp-enrich, or a text → keywords of the document and of each page, with the method, score and rank of every keyword.",
    "version": "1.0.0",
    "x-atrium-service": "atrium-keyword-extract",
    "x-atrium-service-previous": "atrium-nlp-enrich"
  },
  "paths": {
    "/info": {
      "get": {
        "summary": "Info",
        "operationId": "info",
        "responses": {
          "200": {
            "description": "Identity, limits, capabilities.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KeywordInfo"
                }
              }
            }
          },
          "500": {
            "description": "Processing failed. Report it; do not retry blindly.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health",
        "parameters": [
          {
            "name": "deep",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false,
              "title": "Deep"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Alive; with `?deep=true`, the backends answer too.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthBody"
                }
              }
            }
          },
          "422": {
            "description": "Unusable or invalid input: request validation (`errors`), a bad parameter, a record that cannot be opened (`reason: invalid_record`), or a parameter or per-input budget over its limit (`reason: limit_exceeded`). Do not retry unchanged.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "500": {
            "description": "Processing failed. Report it; do not retry blindly.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "503": {
            "description": "`degraded`: the deep check failed, or the replica drains.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthBody"
                }
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "summary": "Ready",
        "operationId": "ready",
        "responses": {
          "200": {
            "description": "`ready`: route new work here.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyBody"
                }
              }
            }
          },
          "500": {
            "description": "Processing failed. Report it; do not retry blindly.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "503": {
            "description": "`starting` or `draining`: route new work elsewhere.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyBody"
                }
              }
            }
          }
        }
      }
    },
    "/extract_keywords": {
      "post": {
        "summary": "Extract Keywords",
        "operationId": "extract_keywords",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_extract_keywords"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The keywords, per document and per page.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExtractResponse"
                }
              }
            }
          },
          "422": {
            "description": "Unusable or invalid input: request validation (`errors`), a bad parameter, a record that cannot be opened (`reason: invalid_record`), or a parameter or per-input budget over its limit (`reason: limit_exceeded`). Do not retry unchanged.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "500": {
            "description": "Processing failed. Report it; do not retry blindly.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "413": {
            "description": "The request content is over a limit (`reason: limit_exceeded`). Split the input or raise the limit.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "429": {
            "description": "Busy (`reason: busy`): every processing slot or queue place is taken. Retry after `Retry-After` seconds.",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait before retrying.",
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "501": {
            "description": "This deployment cannot read the input: a reader's optional dependency is not installed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/extract_keywords_text": {
      "post": {
        "summary": "Extract Keywords Text",
        "description": "`/extract_keywords` on a plain text (§4.3, the JSON sibling of the upload endpoint).",
        "operationId": "extract_keywords_text",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExtractTextRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The document's keywords.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExtractResponse"
                }
              }
            }
          },
          "422": {
            "description": "Unusable or invalid input: request validation (`errors`), a bad parameter, a record that cannot be opened (`reason: invalid_record`), or a parameter or per-input budget over its limit (`reason: limit_exceeded`). Do not retry unchanged.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "500": {
            "description": "Processing failed. Report it; do not retry blindly.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "413": {
            "description": "The request content is over a limit (`reason: limit_exceeded`). Split the input or raise the limit.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "429": {
            "description": "Busy (`reason: busy`): every processing slot or queue place is taken. Retry after `Retry-After` seconds.",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait before retrying.",
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "501": {
            "description": "This deployment cannot read the input: a reader's optional dependency is not installed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Body_extract_keywords": {
        "properties": {
          "document_json": {
            "type": "string",
            "contentMediaType": "application/json",
            "title": "Document Json",
            "description": "The ATRIUM document record, after nlp-enrich: its `lines[].text` are read per page (lines categorised `Trash` or `Empty` are left out), and for the legacy method its `lines[].lemma` and `lines[].upos`. A record that cannot be opened is refused (422 `invalid_record`); one with no text, 422."
          },
          "kind": {
            "type": "string",
            "enum": [
              "statistical",
              "controlled",
              "both"
            ],
            "title": "Kind",
            "description": "`statistical`, `controlled` or `both`.",
            "default": "both"
          },
          "method": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "keybert",
                  "yake",
                  "legacy"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Method",
            "description": "The statistical method: `keybert`, `yake` or `legacy`. Absent: the server's default (`/info` `methods.default`, the `DEFAULT_KW_METHOD` setting)."
          },
          "num_keywords": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Num Keywords",
            "description": "How many keywords per list; at most `max_keywords`.",
            "default": 20
          },
          "lang": {
            "type": "string",
            "const": "cs",
            "title": "Lang",
            "default": "cs"
          },
          "per_page": {
            "type": "boolean",
            "title": "Per Page",
            "description": "Also extract per page, from the record's `lines[].page`.",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "document_json"
        ],
        "title": "Body_extract_keywords"
      },
      "CreateAction": {
        "properties": {
          "@context": {
            "anyOf": [
              {},
              {
                "type": "null"
              }
            ],
            "title": "@Context",
            "description": "The JSON-LD context: RO-Crate 1.2, plus the terms ATRIUM adds."
          },
          "@id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "@Id",
            "description": "The run's `urn:uuid:...`, equal to `run_uuid` in the blocks the call stamped into the record."
          },
          "@type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "@Type",
            "description": "`CreateAction`."
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name",
            "description": "A human-readable name of the run."
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description",
            "description": "What the action describes."
          },
          "instrument": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Instrument",
            "description": "The tool: a `SoftwareApplication` with `version`, its release page as `@id`, its repository as `url` and its authors as `creator`."
          },
          "containerImage": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Containerimage",
            "description": "The image the service ran as (`ATRIUM_RUNNER_IMAGE`): `registry`, `name`, `tag`."
          },
          "object": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Object",
            "description": "The inputs: the uploaded file (`@id` `ni:///sha-256;...`, with `sha256` and `contentSize`) and `#record`, the record sent with it."
          },
          "result": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Result",
            "description": "The outputs: the record blocks the call wrote (`#block-<name>`) and any output file."
          },
          "agent": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Agent",
            "description": "The organisation operating the service (`ATRIUM_RUN_AGENT`); absent when it is not set."
          },
          "startTime": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Starttime",
            "description": "When the run started: `YYYY-MM-DDTHH:MM:SS+00:00`."
          },
          "endTime": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Endtime",
            "description": "When the run ended: `YYYY-MM-DDTHH:MM:SS+00:00`."
          },
          "actionStatus": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Actionstatus",
            "description": "`http://schema.org/CompletedActionStatus` or `http://schema.org/FailedActionStatus`."
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error",
            "description": "Why the run failed, with `FailedActionStatus`."
          },
          "paradataRecord": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Paradatarecord",
            "description": "The run's atrium_paradata record (schema 2.0), as the tool wrote it."
          }
        },
        "additionalProperties": true,
        "type": "object",
        "title": "CreateAction",
        "description": "The RO-Crate `CreateAction` of this call: its provenance (atrium-project#71 R2).\n\nOne Process Run Crate 0.5 action per call, as nested JSON-LD, built by\n`atrium_rocrate.create_action()`; the same document an archive stores as the run's paradata\nfile. It names the tool as its `instrument` (with `version`, its release page as `@id` and its\nauthors as `creator`), the image as `containerImage`, the inputs as `object`, what the call\nwrote as `result`, the `agent`, `startTime`/`endTime` and `actionStatus`, and the run's whole\nparadata record as `paradataRecord`. Every service returns it with a successful response; its\n`@id` is the `run_uuid` the call stamped into the record it returned."
      },
      "ErrorBody": {
        "properties": {
          "status": {
            "type": "integer",
            "title": "Status",
            "description": "The HTTP status, as an integer."
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason",
            "description": "A registered reason code, listed with its statuses in the spec's `x-atrium-reason-codes`, or null when no code is registered for the cause. An open string: a release may add a code, but never renames or removes one."
          },
          "detail": {
            "type": "string",
            "title": "Detail",
            "description": "A human-readable message."
          },
          "limit": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/LimitRef"
              },
              {
                "type": "null"
              }
            ],
            "description": "Only with `limit_exceeded`: the limit and the input's size."
          },
          "errors": {
            "anyOf": [
              {
                "items": {},
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Errors",
            "description": "The request-validation problems, or a structured detail."
          },
          "accepted": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Accepted",
            "description": "Only with `unsupported_media_type`: the file extensions or media types the endpoint reads."
          },
          "cause": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cause",
            "description": "A finer, unregistered cause (for example a reader's code). Informational; it may change."
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "status",
          "reason",
          "detail"
        ],
        "title": "ErrorBody",
        "description": "The body of every error a service returns (§4.4)."
      },
      "ExtractResponse": {
        "properties": {
          "doc_id": {
            "type": "string",
            "title": "Doc Id",
            "description": "The record's `doc_id`, or the request's."
          },
          "kind": {
            "type": "string",
            "title": "Kind",
            "description": "The kind asked for: `statistical`, `controlled` or `both`."
          },
          "method_requested": {
            "type": "string",
            "title": "Method Requested",
            "description": "The method asked for (the server default when none was)."
          },
          "method_used": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Method Used",
            "description": "The statistical method that ran, or null when none did."
          },
          "keywords": {
            "items": {
              "$ref": "#/components/schemas/Keyword"
            },
            "type": "array",
            "title": "Keywords",
            "description": "The document's statistical keywords, best first."
          },
          "pages": {
            "items": {
              "$ref": "#/components/schemas/PageKeywords"
            },
            "type": "array",
            "title": "Pages",
            "description": "The same per page, in page order; empty when `per_page` is false or the input has no pages."
          },
          "kinds": {
            "items": {
              "$ref": "#/components/schemas/KindOutcome"
            },
            "type": "array",
            "title": "Kinds",
            "description": "One entry per kind that was asked for."
          },
          "words": {
            "type": "integer",
            "title": "Words",
            "description": "The words the keywords were extracted from."
          },
          "paradata": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CreateAction"
              },
              {
                "type": "null"
              }
            ],
            "description": "The call's provenance: its Process Run Crate `CreateAction` (atrium-project#71)."
          },
          "limits_applied": {
            "items": {
              "$ref": "#/components/schemas/LimitNote"
            },
            "type": "array",
            "title": "Limits Applied",
            "description": "Every limit that shaped the result without refusing it."
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "doc_id",
          "kind",
          "method_requested",
          "method_used",
          "keywords",
          "pages",
          "kinds",
          "words",
          "paradata",
          "limits_applied"
        ],
        "title": "ExtractResponse",
        "description": "The keywords of the document and of its pages, and the run's paradata."
      },
      "ExtractTextRequest": {
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "title": "Text",
            "description": "The text to extract keywords from."
          },
          "doc_id": {
            "type": "string",
            "title": "Doc Id",
            "description": "The document's id, echoed in the response.",
            "default": "document"
          },
          "kind": {
            "type": "string",
            "enum": [
              "statistical",
              "controlled",
              "both"
            ],
            "title": "Kind",
            "description": "`statistical`, `controlled` or `both`.",
            "default": "both"
          },
          "method": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "keybert",
                  "yake",
                  "legacy"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Method",
            "description": "The statistical method; the server default when absent."
          },
          "num_keywords": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Num Keywords",
            "description": "How many keywords to return; at most `max_keywords`.",
            "default": 20
          },
          "lang": {
            "type": "string",
            "const": "cs",
            "title": "Lang",
            "default": "cs"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "text"
        ],
        "title": "ExtractTextRequest",
        "description": "The body of `/extract_keywords_text`: a text, and the options `/extract_keywords` takes as form fields."
      },
      "HealthBody": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "description": "`ok`, or `degraded` (HTTP 503) when the deep check fails or the replica drains."
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail",
            "description": "Why the deep check failed."
          },
          "in_flight": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "In Flight",
            "description": "Deep check only: requests being served."
          },
          "draining": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Draining",
            "description": "Deep check only: the replica is shutting down."
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "status"
        ],
        "title": "HealthBody",
        "description": "`GET /health`: liveness, and with `?deep=true` a check of the backends."
      },
      "Keyword": {
        "properties": {
          "keyword": {
            "type": "string",
            "title": "Keyword",
            "description": "The keyword or phrase."
          },
          "score": {
            "type": "number",
            "title": "Score",
            "description": "The method's score, higher is more relevant. Scores mean different things per method (KeyBERT: a cosine; YAKE: normalised per document; KER: an occurrence count), so compare them only within one method and one list."
          },
          "method": {
            "type": "string",
            "title": "Method",
            "description": "The method that produced it: `keybert`, `yake` or `legacy`."
          },
          "rank": {
            "type": "integer",
            "title": "Rank",
            "description": "Its place in its list, from 1."
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "keyword",
          "score",
          "method",
          "rank"
        ],
        "title": "Keyword",
        "description": "One statistical keyword, with how it was found."
      },
      "KeywordInfo": {
        "properties": {
          "service": {
            "type": "string",
            "title": "Service",
            "description": "The tool id, which is the repository name."
          },
          "version": {
            "type": "string",
            "title": "Version",
            "description": "The tool version (`para_config.txt`), as in the release tag without the `v`."
          },
          "endpoints": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Endpoints",
            "description": "The callable API paths."
          },
          "limits": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
