# atrium-nlp-enrich — the published environment contract (atrium-project#60).
#
# Copy to `.env` and edit. Do not commit `.env` (gitignored).
#
# NOT to be confused with annotation/env.example. That file configures the
# standalone Doccano / Label Studio annotation stack, has a different audience, and
# carries admin credentials. Keep the two separate; neither supersedes the other.
#
# This file is the COMPLETE ledger: every variable the api image reads, at the
# default that is in the CODE. The operator-facing subset across all five services is
# the table in the hub's docs/k8s_deployment.md; this file's layout is fixed by
# docs/templates/env.example.template in ufal/atrium-project. Batch-pipeline knobs
# (ALTO_DIR, SAVE_CSV, TEITOK_OUTPUT_DIR, SUMMARY_* and the rest of
# api_util/summarize_nt_udp.py's ~15 variables) are deliberately NOT here: they
# belong to config_api.txt and the api_N_*.sh stages, which the api image drives as a
# subprocess and a deployment never configures directly.
#
# TAG LEGEND: [required] raises at startup without it · [secret] never a literal
# anywhere committed, use a k8s Secret · [operator] an ordinary deployment knob ·
# [algorithmic] changes what the service COMPUTES, not how it is deployed ·
# [build] read by compose/Dockerfile or baked at build time · [limit] a limit
# (atrium-project#53): reported in GET /info, listed in service/README.md § Limits
#
# HOW THIS FILE REACHES THE PROCESS
#   docker compose  → delivered. docker-compose.yaml's `nlp-api` service declares
#                     `env_file: .env`, so everything below is injected into the
#                     container. Four names (MAX_CONCURRENT_JOBS, DEFAULT_KW_METHOD,
#                     PORT, UDPIPE_URL, NAMETAG_URL) are ALSO named explicitly in the
#                     `environment:` block as `${VAR:-default}`, because compose
#                     itself needs PORT for the `ports:` mapping, and because
#                     /info reports and `?deep=true` probes the backing-service URLs
#                     — those two used to be LITERALS that overrode .env entirely
#                     (atrium-project#60 converted them).
#   Kubernetes      → NOT delivered. Use the manifest's own env: block. See
#                     ufal/atrium-project docs/k8s_deployment.md.
#   python -m service.api
#                   → NOT delivered. Nothing here calls load_dotenv(); export the
#                     values yourself:  set -a; . ./.env; set +a
#
# BLANK IS NOT UNIVERSALLY "UNSET". ALLOWED_ORIGINS is the trap: a blank value parses
# to an EMPTY origin list and blocks every browser request, where omitting the line
# gives you `*` — so it ships commented below, not blank. The backing-service URLs are
# the safe case: blank there really does mean "use the LINDAT default," and
# config_api.txt:30-31 holds them as "${UDPIPE_URL:-<lindat>}" so a bare assignment
# would clobber a deployment-set value across `source`.

# ── §0 Required before first start ─────────────────────────────────────────────
# None — this service starts with no variables set.

# ── §1 HTTP surface ─────────────────────────────────────────────────────────────
# [operator] Port the api service binds, and the port service/healthcheck.py probes
# inside the container. docker-compose.yaml maps "${PORT:-8000}:${PORT:-8000}", so
# changing it here moves listener, published port and HEALTHCHECK together. In
# Kubernetes, change `containerPort` in the same edit. (atrium-project#58)
PORT=8000
# [operator] Bind address. Leave at 0.0.0.0. service/healthcheck.py always probes
# 127.0.0.1 by design and never reads HOST, so 127.0.0.1 here gives a container that
# reports HEALTHY to every probe while being unreachable from outside it. This is the
# one value whose failure mode is silent.
# HOST=0.0.0.0
# [operator] CSV of CORS origins. Code default `*` (every origin) —
# service/atrium_service.py:370 falls back to it when unset; unlike alto-postprocess
# and page-classification, this repo's compose file does not narrow it either, so
# `docker compose --profile api up` already serves every origin today. Ships
# commented so an operator who leaves it alone gets the real code default; uncomment
# to narrow it for a real deployment.
# ALLOWED_ORIGINS=*
# [limit] Canonical upload limit in megabytes. 5 is THIS repo's built-in
# (tool_limits.py, `upload_limit(5)`) and the LOWEST of the five — alto 25,
# llm-enrich 10, nlp-enrich 5, page-classification 10, translator 50. Enforced per
# uploaded part on /enrich, /jobs and /rescale (the file, document_json, alto) and on
# the whole /enrich_text body. Over it → 413 limit_exceeded. Default: 5.
MAX_UPLOAD_MB=5
# [deprecated] Do not set. A byte-valued fallback kept working for one release for
# callers that already exported it (strategy §4.5); MAX_UPLOAD_MB wins whenever both
# are present (service/atrium_service.py:353-364). Listed commented-out so the
# contract is complete and the deprecation is discoverable.
# MAX_UPLOAD_BYTES=
# [operator] Path the container's own HEALTHCHECK probes. Change it only alongside
# the route itself.
# HEALTHCHECK_PATH=/health

# ── §2 Lifecycle ────────────────────────────────────────────────────────────────
# [operator] Seconds uvicorn waits for in-flight requests after SIGTERM. Raise
# together with the deployment's grace period (terminationGracePeriodSeconds in k8s,
# see docs/k8s_deployment.md in the hub; stop_grace_period under compose, already 60s
# here). Note serve_lifecycle's own tracked-job drain runs ON TOP of this for a
# /jobs run — budget both.
GRACEFUL_SHUTDOWN_S=20
# [operator] Root logger level for the `python -m service.api` start path. All five
# services honour it identically (atrium-project#61).
LOG_LEVEL=INFO
# [operator] Filesystem auto-reload. Development only — never in a deployment.
# Deliberately NOT wired into any compose or k8s template.
# RELOAD=false

# ── §3 Backing services (atrium-project#63) ─────────────────────────────────────
# [operator] Attachable endpoints: point these at a self-hosted UDPipe 2 / NameTag 3,
# or at a local stub, with no code change and no rebuild.
#
# Precedence, highest first:  --url flag > this variable > config_api.txt >
#                             module constant in api_util/call_*.py
#
# Unset, both fall back to the LINDAT public hosts:
#   UDPIPE_URL   https://lindat.mff.cuni.cz/services/udpipe/api/process
#   NAMETAG_URL  https://lindat.mff.cuni.cz/services/nametag/api/recognize
#
# Whichever value resolves is what /info reports and what `?deep=true` probes, so
# the health surface always names the host the pipeline actually calls. The same
# UDPIPE_URL name is used by atrium-translator, which calls the same service for
# vocabulary lemma matching — deliberately ONE name for one service, though a
# deployment may legitimately set them apart per workload.
UDPIPE_URL=
NAMETAG_URL=

# ── §4 Image / provenance ────────────────────────────────────────────────────────
# [build] Image tag used by docker-compose: on release, para_config.txt's [tool] version
# WITHOUT the leading `v` (para_config.txt says `v0.22.0`, GHCR carries `0.22.0` --
# atrium-project#69, roadmap B3). Read only by docker-compose.yaml; no Python here reads it.
ATRIUM_VERSION=dev
# [build] Baked at build time; stamped into paradata as runner_ref.
ATRIUM_RUNNER_REF=dev
# [build] Override either only if you publish under another name.
# ATRIUM_RUNNER_IMAGE=ghcr.io/ufal/atrium-nlp-enrich:dev
# ATRIUM_RUNNER_REPO=https://github.com/ufal/atrium-nlp-enrich
# [build] The uid docker-compose.yaml runs the containers as (`user: ${ATRIUM_UID:-10001}:0`);
# no Python here reads it. On Linux set it to your own uid -- `echo "ATRIUM_UID=$(id -u)" >> .env`
# (compose does not run `$(...)` itself) -- so the container can write ./data, which a clone
# owns as you. Docker Desktop needs nothing. A named volume created by an older image is
# writable by uid 10001 only: recreate it once (`docker compose down -v`) after setting
# this. (atrium-project#69, roadmap B6)
# ATRIUM_UID=10001
# [build] Correlation id copied verbatim into paradata `request_id`. Read ONCE from
# the process environment at import (atrium_paradata.py's module-level constants),
# so it identifies a batch run, not an individual HTTP request.
# ATRIUM_REQUEST_ID=
# [operator] The IRI (e.g. a ROR id) of the organisation that operates this deployment,
# recorded as the `agent` of every run's CreateAction (atrium-project#71). Unset, no agent
# is recorded; never set it to a processing account, which only reads and calls back.
# ATRIUM_RUN_AGENT=
# [build] Where the HuggingFace model cache lives. The Dockerfile sets this; without
# a matching volume mount the cache is re-downloaded on every start.
# HF_HOME=/cache/huggingface

# ── §5 Service knobs — operator ──────────────────────────────────────────────────
# [operator] Default keyword backend used when a request does not name one.
DEFAULT_KW_METHOD=keybert
# [operator] Where per-job workspaces are created, relative to the repo root when a
# relative path (Rule 3: the real default is computed from the repo root, not the
# literal string below, so it differs whenever the working directory is not the
# repo root). Point this at a volume with room for concurrent jobs — in Kubernetes,
# at a mounted emptyDir or PVC rather than the container filesystem.
# API_JOBS_ROOT=<repo>/TEMP/api_jobs
# [operator] Keep job workspaces after completion. Debugging only: nothing cleans
# them up afterwards, so a busy deployment fills its disk. Blank is the code
# default; 1/true/yes/on enable it.
API_KEEP_WORKSPACES=
#
# Limits (atrium-project#53) — every limit of this service except MAX_UPLOAD_MB (§1),
# declared in tool_limits.py, reported with its current value in GET /info (`limits`;
# `limits_meta` names the variable and whether the value came from the environment, the
# config file or the default), and listed in service/README.md's `## Limits` table. A
# limit that shaped a result without refusing it is returned in the response's
# `limits_applied` and recorded in the paradata. A malformed value stops the service at
# startup, naming the variable.
#
# This repo is the only one of the five with an asynchronous job API, so it is the only
# one with a queue to size.
#
# [limit] Pipelines running at once. Each is a subprocess tree that calls the shared
# LINDAT services, so this bounds real CPU and shields LINDAT from this deployment. A
# synchronous request with every slot taken → 429 busy, with Retry-After. Default: 2.
MAX_CONCURRENT_JOBS=2
# [limit] /jobs submissions that may wait for a slot; one more → 429 busy. 0 accepts a
# job only when a slot is free. Default: 8.
MAX_QUEUED_JOBS=8
# [limit] Seconds one pipeline run may take. Over it the run and every process it
# started are stopped and its workspace removed → 504 limit_exceeded (a /jobs job ends
# `failed`, reason limit_exceeded). Default: 600.
API_JOB_TIMEOUT=600
# [limit] Seconds a finished /jobs job and its result are kept; after that its id is
# 404. Default: 3600.
JOB_TTL_S=3600
# [limit] Words one document may have (/enrich, /enrich_text, /jobs). Over it → 413
# limit_exceeded. Default: 30000.
MAX_WORDS=30000
# [limit] Largest page-image width or height /rescale produces — given as width/height
# or reached through scale. Over it → 422 limit_exceeded. Default: 100000.
MAX_RESCALE_DIM=100000
# [limit] Words per KeyBERT chunk: a longer document is embedded in overlapping chunks
# and its keywords merged, with a `split` note. A chunk longer than the encoder's token
# window (/info keybert_max_seq_tokens, 128 for the default model) is embedded from its
# start, with a `trimmed` note. Default: 400.
KEYBERT_CHUNK_WORDS=400
# [limit] Words two consecutive KeyBERT chunks share. Default: 50.
KEYBERT_CHUNK_OVERLAP=50
# [limit] Entities per page in the entity summary (`ne_summary`, summary_ne_counts.csv);
# a page with more distinct entities keeps its N most frequent, with a `trimmed` note.
# The TEITOK and the document record carry every entity. Default: 20.
NE_SUMMARY_TOP_N=20
#
# The stage limits. Each is ALSO a key of config_api.txt, which the stage scripts read
# (the key is named below); for an API job the variable wins over the file, the file
# over the built-in default. Rule 3: they ship COMMENTED — an active line would be
# copied into .env by CI and override the config file silently. The default given is
# the built-in one, which the shipped config_api.txt also uses.
#
# [limit] Words per UDPipe request; a longer text is sent in pieces cut at a line end
# and annotated in full. Default: 900 (config key WORD_CHUNK_LIMIT).
# WORD_CHUNK_LIMIT=900
# [limit] Per-request timeout of one UDPipe or NameTag call, in seconds; a timeout is
# retried. Default: 60 (config key TIMEOUT).
# LINDAT_TIMEOUT_S=60
# [limit] Attempts of one UDPipe or NameTag call. Once they run out the stage fails →
# 502. Default: 5 (config key MAX_RETRIES).
# LINDAT_MAX_RETRIES=5

# ── §6 Completeness ledger — algorithmic, deprecated, unreachable ────────────────
# None — this repo's remaining reads are all operator-facing and listed above.
